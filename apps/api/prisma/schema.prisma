// ─────────────────────────────────────────────────────────────────────────────
// Hixaa DMS — foundation schema (Phase 1)
//
// Conventions (docs/02-data-model.md §0):
//   • PK          UUID v7 — time-sortable, so index locality matches insert order
//   • Timestamps  createdAt / updatedAt everywhere; deletedAt where soft-deletable
//   • Money       Decimal(18,4) — never float. See ADR-0004
//   • Naming      snake_case in Postgres, camelCase in Prisma via @map
//   • Enums       mirror @hixaa/contracts/enums exactly — one vocabulary
//
// Business domains (distributors, catalog, inventory, sales, finance) arrive in
// Phases 3–8. This file is the scaffolding they attach to.
// ─────────────────────────────────────────────────────────────────────────────

// No custom `output`: pnpm stores @prisma/client in the content-addressed
// store, and a custom output path generates the client somewhere the
// `@prisma/client` import cannot resolve. The default location is correct here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// ENUMS — mirror packages/contracts/src/enums.ts
// ═════════════════════════════════════════════════════════════════════════════

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ScopeType {
  GLOBAL
  TERRITORY
  DISTRIBUTOR
}

enum ActorType {
  USER
  SYSTEM
  API_KEY
}

enum AuditCategory {
  AUTH
  DATA
  SECURITY
  INTEGRATION
}

enum MfaType {
  TOTP
  BACKUP_CODE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum MailChannel {
  BUSINESS
  OPS
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum StorageProvider {
  LOCAL
  S3
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum DocumentVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NumberResetPolicy {
  NEVER
  YEARLY
  MONTHLY
}

// ═════════════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id String @id @default(uuid(7)) @db.Uuid

  // Stored lowercase (enforced by emailSchema in @hixaa/contracts) so a plain
  // unique index gives case-insensitive uniqueness without the citext extension.
  email        String  @unique
  passwordHash String? @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")

  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)

  // Auth hardening — see docs/06-security.md §3
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp         String?   @map("last_login_ip")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  isSystem Boolean @default(false) @map("is_system")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  roles                  UserRole[]
  sessions               Session[]
  mfaFactors             MfaFactor[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  teamMemberships        TeamMember[]
  managedTeams           Team[]                    @relation("TeamManager")
  managedTerritories     Territory[]               @relation("TerritoryManager")
  managedDistributors    Distributor[]             @relation("DistributorAccountManager")
  distributorNotes       DistributorNote[]         @relation("DistributorNoteAuthor")
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  apiKeys                ApiKey[]
  uploadedDocuments      Document[]

  @@index([status, deletedAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("user")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique
  name        String
  description String?
  scopeType   ScopeType @default(GLOBAL) @map("scope_type")

  /// System roles are seeded and cannot be deleted or renamed.
  isSystem Boolean @default(false) @map("is_system")

  /// Approval hierarchy rank — a higher level may approve what a lower cannot.
  level Int @default(0)

  /// Monetary authority. Null means unlimited. See docs/04-rbac §4.
  maxDiscountPercent Decimal? @map("max_discount_percent") @db.Decimal(7, 4)
  maxOrderValue      Decimal? @map("max_order_value") @db.Decimal(18, 4)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("role")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// The join that carries the DATA BOUNDARY, not just the role. `scopeType` +
/// `scopeId` is the single mechanism that will make the v2 Distributor Portal
/// safe without a second auth system. See ADR-0003.
model UserRole {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  scopeType ScopeType @default(GLOBAL) @map("scope_type")
  /// Null when scopeType is GLOBAL; a territory or distributor id otherwise.
  scopeId   String?   @map("scope_id") @db.Uuid

  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  assignedById String?   @map("assigned_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@map("user_role")
}

/// Refresh-token lineage. `familyId` groups a rotation chain so that replaying a
/// rotated token can revoke the entire family. See docs/04-rbac §6.
model Session {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque refresh token. The raw value is never stored.
  refreshTokenHash String  @unique @map("refresh_token_hash")
  familyId         String  @map("family_id") @db.Uuid
  replacedById     String? @map("replaced_by_id") @db.Uuid

  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  rememberMe Boolean @default(false) @map("remember_me")

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_token")
}

model MfaFactor {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  type   MfaType @default(TOTP)

  /// AES-256-GCM encrypted at rest. See docs/06-security.md §7.
  secretEncrypted String  @map("secret_encrypted")
  /// Hashed single-use recovery codes.
  backupCodes     String[] @map("backup_codes")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factor")
}

model Team {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  managerId   String? @map("manager_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  manager User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members TeamMember[]

  @@index([deletedAt])
  @@map("team")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String @default("MEMBER")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model ApiKey {
  id     String @id @default(uuid(7)) @db.Uuid
  name   String
  /// SHA-256 of the key. The raw value is shown once, at creation.
  keyHash String @unique @map("key_hash")
  prefix  String

  userId      String    @map("user_id") @db.Uuid
  permissions String[]
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_key")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDIT
// ═════════════════════════════════════════════════════════════════════════════

/// Append-only. The application database role is granted only INSERT and SELECT
/// on this table; no update or delete path exists in code.
/// Partitioned by month in production — see docs/02-data-model.md §10.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(USER) @map("actor_type")
  actorLabel  String?   @map("actor_label")

  category AuditCategory @default(DATA)
  action   String

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

// ═════════════════════════════════════════════════════════════════════════════
// TRANSACTIONAL OUTBOX — see ADR-0005
// ═════════════════════════════════════════════════════════════════════════════

/// Written inside the business transaction; published after commit by the
/// dispatcher worker. Guarantees no side effect is ever announced for a
/// transaction that rolled back, and keeps every third-party call off the
/// request path.
model OutboxEvent {
  id String @id @default(uuid(7)) @db.Uuid

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventType     String @map("event_type")

  payload Json

  status   OutboxStatus @default(PENDING)
  attempts Int          @default(0)

  /// Backoff target. The dispatcher only picks up rows whose time has come.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")

  actorUserId String? @map("actor_user_id") @db.Uuid
  requestId   String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // The dispatcher's poll. A partial index on this pair keeps the query fast
  // regardless of how large the processed history grows.
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// ═════════════════════════════════════════════════════════════════════════════
// MAIL & NOTIFICATIONS
// ═════════════════════════════════════════════════════════════════════════════

/// Every send is logged with its CHANNEL, so a business email appearing on the
/// ops transport (or vice versa) is visible in data as well as impossible in
/// types. See docs/07-integrations.md §1.
model EmailLog {
  id      String      @id @default(uuid(7)) @db.Uuid
  channel MailChannel

  toAddress String   @map("to_address")
  ccAddress String[] @map("cc_address")
  subject   String
  template  String

  status            EmailStatus @default(QUEUED)
  providerMessageId String?     @map("provider_message_id")
  attempts          Int         @default(0)
  error             String?
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([channel, status])
  @@index([toAddress])
  @@index([createdAt(sort: Desc)])
  @@map("email_log")
}

model Notification {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type     String
  title    String
  body     String
  data     Json?
  priority NotificationPriority @default(NORMAL)

  actionUrl String?   @map("action_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

model NotificationPreference {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  type   String

  channels NotificationChannel[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preference")
}

// ═════════════════════════════════════════════════════════════════════════════
// DOCUMENTS
// ═════════════════════════════════════════════════════════════════════════════

model Document {
  id String @id @default(uuid(7)) @db.Uuid

  storageKey String          @unique @map("storage_key")
  provider   StorageProvider @default(LOCAL)

  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    BigInt @map("size_bytes")
  /// Integrity check and cheap deduplication key.
  checksumSha256 String @map("checksum_sha256")

  /// A document stays undownloadable until a scanner clears it. The NoOp driver
  /// marks SKIPPED in dev; ClamAV sets CLEAN or INFECTED in production.
  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  scanEngine String?    @map("scan_engine")
  scannedAt  DateTime?  @map("scanned_at") @db.Timestamptz(3)

  visibility DocumentVisibility @default(INTERNAL)

  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  uploadedBy User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  links      DocumentLink[]
  kycRecords DistributorDocument[]
  agreements Agreement[]
  productMedia ProductMedia[]

  @@index([checksumSha256])
  @@index([scanStatus])
  @@index([deletedAt])
  @@map("document")
}

/// Generic attachment join — lets any entity own documents without a foreign key
/// per owner type.
model DocumentLink {
  id         String @id @default(uuid(7)) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  purpose    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId, purpose])
  @@index([entityType, entityId])
  @@map("document_link")
}

// ═════════════════════════════════════════════════════════════════════════════
// SYSTEM
// ═════════════════════════════════════════════════════════════════════════════

/// How "nothing about the company is hardcoded" is honoured. Company profile,
/// branding, service lines, industries, approval ceilings, and feature flags all
/// live here — seeded on first boot, editable from the Admin Panel thereafter.
model SystemSetting {
  id       String @id @default(uuid(7)) @db.Uuid
  category String
  key      String
  value    Json

  description String?
  /// Secret values are redacted in API responses and never sent to Sheets.
  isSecret    Boolean @default(false) @map("is_secret")

  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([category, key])
  @@index([category])
  @@map("system_setting")
}

/// Gapless business number allocation. Consumed inside the same transaction as
/// the document it numbers, with SELECT … FOR UPDATE, so a rolled-back
/// transaction never burns a number. Critical for GST invoice series.
model NumberSequence {
  id     String @id @default(uuid(7)) @db.Uuid
  key    String @unique
  prefix String

  nextValue Int @default(1) @map("next_value")
  padding   Int @default(5)

  financialYear String?           @map("financial_year")
  resetPolicy   NumberResetPolicy @default(YEARLY) @map("reset_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("number_sequence")
}

/// Makes a retried money-moving POST safe. Same key + same body replays the
/// stored response; same key + different body is a 409.
model IdempotencyKey {
  id  String @id @default(uuid(7)) @db.Uuid
  key String

  userId      String  @map("user_id") @db.Uuid
  endpoint    String
  requestHash String  @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, userId, endpoint])
  @@index([expiresAt])
  @@map("idempotency_key")
}

model FeatureFlag {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  enabled     Boolean @default(false)
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

// ═════════════════════════════════════════════════════════════════════════════
// GEOGRAPHY & TERRITORIES  (Phase 3)
// ═════════════════════════════════════════════════════════════════════════════

enum TerritoryType {
  ZONE
  REGION
  STATE
  DISTRICT
}

model Country {
  id       String @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-1 alpha-2.
  code     String @unique
  name     String
  dialCode String @map("dial_code")
  currency String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  states State[]

  @@map("country")
}

/// The GST state code is the single most operationally important field in this
/// context: it is the input to the place-of-supply rule that decides whether a
/// line is taxed CGST+SGST or IGST. A wrong value produces legally defective
/// invoices. See docs/02-data-model.md §7.
model State {
  id           String @id @default(uuid(7)) @db.Uuid
  countryId    String @map("country_id") @db.Uuid
  name         String
  /// Postal abbreviation, e.g. MH.
  code         String
  /// Two-digit GST code, e.g. 27. Matches GSTIN characters 1–2.
  gstStateCode String @unique @map("gst_state_code")
  /// Union territories are taxed with UTGST rather than SGST.
  isUnionTerritory Boolean @default(false) @map("is_union_territory")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country    Country     @relation(fields: [countryId], references: [id])
  cities     City[]
  addresses  Address[]
  territories Territory[]

  @@unique([countryId, code])
  @@index([countryId, isActive])
  @@map("state")
}

model City {
  id      String @id @default(uuid(7)) @db.Uuid
  stateId String @map("state_id") @db.Uuid
  name    String
  /// Optional default PIN, useful for address autocomplete.
  pincode String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  state     State     @relation(fields: [stateId], references: [id])
  addresses Address[]

  @@unique([stateId, name])
  @@index([stateId, isActive])
  @@map("city")
}

/// Referenced by FK from its owners (warehouse, distributor, customer) rather
/// than being polymorphic — a real foreign key is enforceable and joinable;
/// an entityType/entityId pair is neither.
model Address {
  id      String  @id @default(uuid(7)) @db.Uuid
  label   String?
  line1   String
  line2   String?
  landmark String?

  cityId     String? @map("city_id") @db.Uuid
  cityName   String  @map("city_name")
  stateId    String  @map("state_id") @db.Uuid
  postalCode String  @map("postal_code")
  countryCode String @default("IN") @map("country_code")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  state State @relation(fields: [stateId], references: [id])
  city  City? @relation(fields: [cityId], references: [id])

  warehouses          Warehouse[]
  billingDistributors  Distributor[] @relation("DistributorBilling")
  shippingDistributors Distributor[] @relation("DistributorShipping")

  @@index([stateId])
  @@index([postalCode])
  @@index([deletedAt])
  @@map("address")
}

/// Sales geography, as a tree: Zone → Region → State → District.
///
/// This is the FIRST scoped entity. Registering it in SCOPE_REGISTRY is what
/// makes the Prisma scope extension start filtering real rows — see ADR-0003.
model Territory {
  id       String        @id @default(uuid(7)) @db.Uuid
  code     String        @unique
  name     String
  type     TerritoryType @default(REGION)
  parentId String?       @map("parent_id") @db.Uuid

  /// Materialised path of ancestor ids, e.g. `.<zoneId>.<regionId>.`.
  ///
  /// Turns "everything under the West zone" into one indexed LIKE instead of a
  /// recursive CTE per request. Leading and trailing dots make `LIKE '%.<id>.%'`
  /// unambiguous — without them, one id could prefix-match another.
  path  String @default("")
  depth Int    @default(0)

  /// Optional link to a State, so a STATE-type territory inherits its GST code.
  stateId String? @map("state_id") @db.Uuid

  managerId   String? @map("manager_id") @db.Uuid
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  parent   Territory?  @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Territory[] @relation("TerritoryTree")
  state    State?      @relation(fields: [stateId], references: [id])
  manager  User?       @relation("TerritoryManager", fields: [managerId], references: [id], onDelete: SetNull)

  warehouses   Warehouse[]
  distributors Distributor[]

  @@index([parentId])
  @@index([path])
  @@index([type, isActive])
  @@index([managerId])
  @@index([deletedAt])
  @@map("territory")
}

enum WarehouseType {
  COMPANY
  DISTRIBUTOR
  TRANSIT
  SCRAP
}

/// Introduced here because a warehouse is a location, and locations belong with
/// geography. The stock LEDGER that gives it meaning arrives in Phase 6.
model Warehouse {
  id   String        @id @default(uuid(7)) @db.Uuid
  code String        @unique
  name String
  type WarehouseType @default(COMPANY)

  addressId   String? @map("address_id") @db.Uuid
  territoryId String? @map("territory_id") @db.Uuid

  /// Set when type = DISTRIBUTOR. The FK arrives with the Distributor model in
  /// Phase 5; kept as a plain column now so no migration is needed then.
  distributorId String? @map("distributor_id") @db.Uuid

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  address   Address?   @relation(fields: [addressId], references: [id])
  territory Territory? @relation(fields: [territoryId], references: [id])

  @@index([type, isActive])
  @@index([territoryId])
  @@index([distributorId])
  @@index([deletedAt])
  @@map("warehouse")
}

/// Industries Hixaa serves — thermal power, coal, mining, cement, rail
/// simulation. Promoted from a SystemSetting JSON blob to real rows now that
/// customers (Phase 7) will reference them by FK.
model Industry {
  id          String  @id @default(uuid(7)) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("industry")
}

// ═════════════════════════════════════════════════════════════════════════════
// DISTRIBUTORS — the channel  (Phase 5)
// ═════════════════════════════════════════════════════════════════════════════

enum DistributorType {
  DISTRIBUTOR
  DEALER
  SYSTEM_INTEGRATOR
  OEM_PARTNER
}

enum DistributorStatus {
  LEAD
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum KycDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  AGREEMENT
  CANCELLED_CHEQUE
  MSME_CERT
  OTHER
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/// A channel partner: distributor, dealer, system integrator, or OEM partner.
///
/// The SECOND scoped entity (after Territory). Registered in SCOPE_REGISTRY so
/// a territory-scoped user can only ever read the distributors in their own
/// subtree — see ADR-0003 and docs/15 §6.
model Distributor {
  id        String            @id @default(uuid(7)) @db.Uuid
  /// Human-readable, allocated from NumberSequence: DIST-00042.
  code      String            @unique
  legalName String            @map("legal_name")
  tradeName String?           @map("trade_name")
  type      DistributorType   @default(DISTRIBUTOR)
  status    DistributorStatus @default(LEAD)

  territoryId      String? @map("territory_id") @db.Uuid
  accountManagerId String? @map("account_manager_id") @db.Uuid

  /// Assigned price list. Phase 5 left this as a plain column because PriceList
  /// did not exist yet; Phase 4 closed the seam and it is now a real FK.
  /// `onDelete: Restrict` — a list with partners on it cannot be deleted out
  /// from under them, which would silently reprice every future order.
  priceListId String? @map("price_list_id") @db.Uuid

  billingAddressId  String? @map("billing_address_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  // ── Statutory identity ──────────────────────────────────────────────────
  /// Validated for format AND check digit before storage — a typo here
  /// produces a legally defective invoice that must be cancelled by credit note.
  gstin      String? @unique
  pan        String?
  tan        String?
  cin        String?
  msmeNumber String? @map("msme_number")

  // ── Commercial terms ────────────────────────────────────────────────────
  creditLimit    Decimal @default(0) @map("credit_limit") @db.Decimal(18, 4)
  creditDays     Int     @default(30) @map("credit_days")
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(18, 4)
  paymentTermsCode String? @map("payment_terms_code")

  // ── Banking. The account number is encrypted at rest (AES-256-GCM). ──────
  bankAccountName      String? @map("bank_account_name")
  bankAccountEncrypted String? @map("bank_account_encrypted")
  bankIfsc             String? @map("bank_ifsc")
  bankName             String? @map("bank_name")

  website String?
  tags    String[]

  onboardedAt   DateTime? @map("onboarded_at") @db.Timestamptz(3)
  suspendedAt   DateTime? @map("suspended_at") @db.Timestamptz(3)
  statusReason  String?   @map("status_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  territory      Territory? @relation(fields: [territoryId], references: [id])
  accountManager User?      @relation("DistributorAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  billingAddress  Address?  @relation("DistributorBilling", fields: [billingAddressId], references: [id])
  shippingAddress Address?  @relation("DistributorShipping", fields: [shippingAddressId], references: [id])

  priceList PriceList? @relation(fields: [priceListId], references: [id], onDelete: Restrict)

  contacts  DistributorContact[]
  documents DistributorDocument[]
  notes     DistributorNote[]
  agreements Agreement[]
  /// The authorized catalog — which products this partner may buy (Phase 4).
  authorizedProducts DistributorProduct[]

  @@index([status, territoryId])
  @@index([priceListId])
  @@index([accountManagerId])
  @@index([territoryId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("distributor")
}

model DistributorContact {
  id            String  @id @default(uuid(7)) @db.Uuid
  distributorId String  @map("distributor_id") @db.Uuid

  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false) @map("is_primary")

  /// The seam for the v2 Distributor Portal: onboarding a distributor user is
  /// creating a User and linking it here, not building a second auth system.
  portalUserId String? @map("portal_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([portalUserId])
  @@map("distributor_contact")
}

/// KYC. A distributor cannot be approved until the required types are verified.
model DistributorDocument {
  id            String          @id @default(uuid(7)) @db.Uuid
  distributorId String          @map("distributor_id") @db.Uuid
  documentId    String          @map("document_id") @db.Uuid
  type          KycDocumentType

  /// Certificates expire; an expiry sweep warns before they lapse.
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedById String?   @map("verified_by_id") @db.Uuid
  rejectedAt   DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id])

  @@unique([distributorId, type, documentId])
  @@index([distributorId, type])
  @@index([expiresAt])
  @@map("distributor_document")
}

model DistributorNote {
  id            String  @id @default(uuid(7)) @db.Uuid
  distributorId String  @map("distributor_id") @db.Uuid
  authorId      String? @map("author_id") @db.Uuid
  body          String
  isPinned      Boolean @default(false) @map("is_pinned")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  author      User?       @relation("DistributorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([distributorId, isPinned, createdAt(sort: Desc)])
  @@map("distributor_note")
}

model Agreement {
  id            String          @id @default(uuid(7)) @db.Uuid
  distributorId String          @map("distributor_id") @db.Uuid
  reference     String?
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  targetAmount  Decimal?        @map("target_amount") @db.Decimal(18, 4)
  status        AgreementStatus @default(DRAFT)
  documentId    String?         @map("document_id") @db.Uuid
  notes         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id])

  @@index([distributorId, status])
  @@index([endDate])
  @@map("agreement")
}

// ═════════════════════════════════════════════════════════════════════════════
// CATALOG & PRICING (Phase 4)
//
// Shaped by the single most important domain fact: Hixaa sells SYSTEMS, not
// SKUs. A Raksha IoT deployment is gateways + tags + a licence + commissioning,
// and commissioning is a SERVICE carrying a SAC code on the same invoice as the
// goods. Hence four product types, a bill of materials, specifications as rows,
// and HSN alongside SAC. See docs/00-domain-and-scope.md §1.1 and docs/17.
// ═════════════════════════════════════════════════════════════════════════════

enum ProductType {
  GOODS
  SERVICE
  KIT
  CONFIGURABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

enum ProductMediaType {
  IMAGE
  BROCHURE
  DATASHEET
  MANUAL
  CERTIFICATE
  VIDEO
  CAD
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Whether a list's prices include tax. Stored explicitly rather than assumed:
/// a column of numbers carries no memory of which convention produced it.
/// Hixaa quotes ex-GST — see ADR-0008.
enum PriceBasis {
  EXCLUSIVE
  INCLUSIVE
}

enum DiscountScope {
  GLOBAL
  PRICE_LIST
  DISTRIBUTOR
  CATEGORY
  PRODUCT
}

enum DiscountType {
  PERCENT
  FLAT
}

/// Unit of measure, carrying the GST-mandated **UQC** code.
///
/// A separate table rather than a free-text column because UQC is validated when
/// GSTR-1 is filed: "pieces" is rejected where `NOS` is required, and finding
/// that out at filing time means re-issuing invoices.
model UnitOfMeasure {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String
  /// The GST Unit Quantity Code — NOS, SET, MTR, KGS, HRS…
  uqc  String
  /// Decimal places allowed. 0 for NOS: half a gateway is not a thing.
  precision Int     @default(0)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@map("unit_of_measure")
}

/// Hixaa's own brand plus the OEM brands it integrates and resells.
model Brand {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String
  slug String @unique

  description String?
  website     String?
  logoDocumentId String? @map("logo_document_id") @db.Uuid
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("brand")
}

/// Nested product categories, seeded from the company's published service lines.
///
/// Uses the SAME materialised-path scheme as Territory, and the same helpers in
/// `modules/territories/territory-path.ts` — a second tree does not need a
/// second implementation, and sharing the code means the cycle guard and the
/// subtree rewrite are already proven.
model Category {
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String  @unique
  name     String
  slug     String  @unique
  parentId String? @map("parent_id") @db.Uuid

  /// `.<ancestorId>.<selfId>.` — leading and trailing dots are load-bearing.
  path  String @default("")
  depth Int    @default(0)

  description String?
  /// Display order among siblings.
  sortOrder   Int     @default(0) @map("sort_order")
  imageDocumentId String? @map("image_document_id") @db.Uuid
  isActive    Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([path])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("category")
}

/// The catalog's central entity.
model Product {
  id     String        @id @default(uuid(7)) @db.Uuid
  sku    String        @unique
  name   String
  slug   String        @unique
  type   ProductType   @default(GOODS)
  status ProductStatus @default(DRAFT)

  categoryId String? @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid
  uomId      String? @map("uom_id") @db.Uuid

  shortDescription String? @map("short_description")
  description      String?

  // ── Tax classification ──────────────────────────────────────────────────
  /// HSN classifies GOODS, SAC classifies SERVICES. A product carries exactly
  /// one — enforced by a CHECK constraint in migration 0006, because a service
  /// invoiced under an HSN code is a filing defect.
  hsnCode String? @map("hsn_code")
  sacCode String? @map("sac_code")
  /// Denormalised snapshot for list display ONLY. `tax_rate` is authoritative —
  /// it is date-effective, and this column is not. See ADR-0008 §2.
  gstRate Decimal @default(18) @map("gst_rate") @db.Decimal(5, 2)

  // ── Physical and commercial attributes ──────────────────────────────────
  /// An IoT safety device in a confined space is a warranty and liability
  /// object: we must be able to say which serial went where. Drives the serial
  /// ledger in Phase 6.
  isSerialized   Boolean @default(false) @map("is_serialized")
  isBatchTracked Boolean @default(false) @map("is_batch_tracked")
  isReturnable   Boolean @default(true) @map("is_returnable")
  isPurchasable  Boolean @default(true) @map("is_purchasable")
  isSellable     Boolean @default(true) @map("is_sellable")

  warrantyMonths Int?     @map("warranty_months")
  leadTimeDays   Int?     @map("lead_time_days")
  minOrderQty    Decimal  @default(1) @map("min_order_qty") @db.Decimal(18, 4)
  weightGrams    Decimal? @map("weight_grams") @db.Decimal(18, 4)

  tags String[]

  /// Postgres-generated tsvector over name, SKU, description and tags, with a
  /// GIN index. Generated columns are not expressible in Prisma, so it is
  /// declared Unsupported here and created in migration 0006 — which also means
  /// Prisma never tries to write it, which is exactly right.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Incremented on every commercially significant change; a quotation issued
  /// against revision 3 stays explicable after revision 4 lands.
  revision Int @default(1)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  uom      UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)

  variants       ProductVariant[]
  specifications ProductSpecification[]
  media          ProductMedia[]
  revisions      ProductRevision[]
  /// This product's own components…
  bomComponents  ProductBom[]         @relation("BomParent")
  /// …and the assemblies this product is a component of.
  bomUsedIn      ProductBom[]         @relation("BomComponent")
  priceListItems PriceListItem[]
  authorizedFor  DistributorProduct[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([type, status])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([hsnCode])
  @@index([sacCode])
  @@index([deletedAt])
  @@map("product")
}

/// A concrete sellable configuration of a CONFIGURABLE product.
model ProductVariant {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku       String @unique
  name      String

  /// The distinguishing attributes, e.g. `{ "range": "50 workers" }`. JSON is
  /// right here (unlike specifications): these are identity, not filter targets.
  attributes Json @default("{}")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListItems PriceListItem[]

  @@index([productId, isActive])
  @@index([deletedAt])
  @@map("product_variant")
}

/// Technical specifications as ROWS, not a JSON blob.
///
/// Industrial buyers filter on specifications — "DAQ modules with 24 V DC
/// supply" is a real query this catalog must answer. JSON cannot be indexed for
/// that anywhere near as cheaply. See docs/02-data-model.md §4.
model ProductSpecification {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Groups specs on the datasheet: "Electrical", "Environmental", "Physical".
  groupName String? @map("group_name")
  name      String
  value     String
  unit      String?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([name, value])
  @@map("product_specification")
}

/// Links a product to an already-uploaded Document. Deliberately does not
/// re-implement upload, scanning, or storage — DocumentsService owns all three.
model ProductMedia {
  id         String           @id @default(uuid(7)) @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  type       ProductMediaType @default(IMAGE)

  title     String?
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([productId, documentId, type])
  @@index([productId, type, sortOrder])
  @@map("product_media")
}

/// Bill of materials — what a KIT explodes into.
///
/// This is what makes "Raksha IoT — 50-Worker Deployment" one sellable line that
/// resolves to gateways, wearable tags, a server licence, and commissioning.
model ProductBom {
  id                 String @id @default(uuid(7)) @db.Uuid
  parentProductId    String @map("parent_product_id") @db.Uuid
  componentProductId String @map("component_product_id") @db.Uuid

  quantity   Decimal @db.Decimal(18, 4)
  /// Optional components appear in the explosion but priced at zero unless
  /// selected — how "add a spare gateway" is modelled without a second SKU.
  isOptional Boolean @default(false) @map("is_optional")
  sortOrder  Int     @default(0) @map("sort_order")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    Product @relation("BomParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  component Product @relation("BomComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  /// A component appears at most once per parent; change the quantity instead.
  @@unique([parentProductId, componentProductId])
  @@index([componentProductId])
  @@map("product_bom")
}

/// Append-only snapshot of a product's commercially significant fields.
///
/// Never updated, never deleted — hence no `deletedAt`, the same reasoning that
/// keeps invoices out of the soft-delete extension.
model ProductRevision {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  revision  Int

  /// The full before-image at the moment of change.
  snapshot  Json
  changedBy String? @map("changed_by") @db.Uuid
  reason    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, revision])
  @@index([productId, createdAt(sort: Desc)])
  @@map("product_revision")
}

/// A named, date-effective set of prices assigned to distributors.
///
/// Versioned by CLONING rather than editing: republishing a live list would
/// silently reprice every order still being negotiated against it.
model PriceList {
  id     String          @id @default(uuid(7)) @db.Uuid
  code   String          @unique
  name   String
  status PriceListStatus @default(DRAFT)

  currency  String     @default("INR") @db.Char(3)
  /// ADR-0008: Hixaa quotes ex-GST. Stored, not assumed.
  priceBasis PriceBasis @default(EXCLUSIVE) @map("price_basis")

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  /// Exactly one list may be the default, enforced by a PARTIAL unique index in
  /// migration 0006 — a plain unique would allow only one `false` row.
  isDefault Boolean @default(false) @map("is_default")

  version      Int     @default(1)
  clonedFromId String? @map("cloned_from_id") @db.Uuid
  description  String?

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  clonedFrom PriceList?  @relation("PriceListVersions", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     PriceList[] @relation("PriceListVersions")

  items               PriceListItem[]
  distributors        Distributor[]
  customFor           DistributorProduct[]

  @@index([status, validFrom])
  @@index([deletedAt])
  @@map("price_list")
}

/// One price point. The `minQty` column IS the volume slab: rows at 1 / 10 / 50
/// for one product are three slabs, and resolution takes the highest `minQty`
/// that does not exceed the ordered quantity.
model PriceListItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  priceListId String  @map("price_list_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid

  /// Lower bound of the slab, inclusive.
  minQty Decimal @default(1) @map("min_qty") @db.Decimal(18, 4)
  /// GST-EXCLUSIVE unit price. See ADR-0008.
  price  Decimal @db.Decimal(18, 4)

  /// Floor below which the pricing engine flags an override as needing
  /// approval, independent of the caller's role ceiling. Null means no floor.
  minPrice Decimal? @map("min_price") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceList PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Uniqueness is enforced by two PARTIAL indexes in migration 0006 rather than
  /// here: Postgres treats NULLs as distinct, so a plain unique on a nullable
  /// `variant_id` would happily accept duplicate product-level slabs.
  @@index([priceListId, productId, minQty(sort: Desc)])
  @@index([productId])
  @@map("price_list_item")
}

/// A discount that may apply to a line. Rules do NOT stack — the highest
/// priority wins and the rest are reported as considered-and-rejected. See
/// ADR-0007 §3 for why.
model DiscountRule {
  id     String        @id @default(uuid(7)) @db.Uuid
  code   String        @unique
  name   String
  scope  DiscountScope @default(GLOBAL)

  /// The scoped entity's id — a product, category, distributor, or price list.
  /// Polymorphic, so no FK is possible; the service validates existence against
  /// the scope on write, which is where the type is actually known.
  targetId String? @map("target_id") @db.Uuid

  type  DiscountType @default(PERCENT)
  /// A percentage (0–100) when type is PERCENT, else an absolute amount.
  value Decimal      @db.Decimal(18, 4)

  minQty    Decimal? @map("min_qty") @db.Decimal(18, 4)
  minAmount Decimal? @map("min_amount") @db.Decimal(18, 4)
  /// Caps a PERCENT discount in absolute terms. Null means uncapped.
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(18, 4)

  /// Lower number wins. Ties break on scope specificity (PRODUCT first).
  priority Int @default(100)

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  isActive  Boolean   @default(true) @map("is_active")

  description String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  @@index([isActive, scope, targetId])
  @@index([validFrom, validTo])
  @@index([deletedAt])
  @@map("discount_rule")
}

/// Date-effective GST rates by HSN/SAC. A rate change is an INSERT; historical
/// invoices resolve the rate in force on their own document date and stay
/// permanently reproducible. See ADR-0008 §2.
model TaxRate {
  id         String @id @default(uuid(7)) @db.Uuid
  hsnSacCode String @map("hsn_sac_code")

  /// Total GST percentage. The CGST/SGST split is derived (half each) rather
  /// than stored, because the split is a property of the TRANSACTION's
  /// geography, not of the rate.
  gstRate  Decimal @map("gst_rate") @db.Decimal(5, 2)
  cessRate Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)

  description String?

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  /// One rate per code per start date. Superseding means inserting a new row
  /// and closing the old one's `effectiveTo`, never editing.
  @@unique([hsnSacCode, effectiveFrom])
  @@index([hsnSacCode, effectiveFrom(sort: Desc)])
  @@map("tax_rate")
}

/// The authorized catalog — which products a distributor may buy.
///
/// Closes the second seam Phase 5 left open. This is the ONLY Phase 4 model
/// that is scope-sensitive: it is registered in SCOPE_REGISTRY as
/// `viaDistributor()`, so a territory-scoped user cannot read or write the
/// commercial terms of a partner outside their subtree. The rest of the catalog
/// is company-wide reference data and is deliberately unscoped.
model DistributorProduct {
  id            String @id @default(uuid(7)) @db.Uuid
  distributorId String @map("distributor_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid

  /// Overrides the distributor's assigned list for this product alone — the
  /// bespoke-terms escape hatch, without cloning a whole list for one SKU.
  customPriceListId String? @map("custom_price_list_id") @db.Uuid

  isActive      Boolean  @default(true) @map("is_active")
  authorizedAt  DateTime @default(now()) @map("authorized_at") @db.Timestamptz(3)
  /// Ceiling on how much of this product the partner may order at once. Null
  /// means unlimited. Enforced by the order module in Phase 7.
  maxOrderQty   Decimal? @map("max_order_qty") @db.Decimal(18, 4)
  notes         String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customPriceList PriceList?  @relation(fields: [customPriceListId], references: [id], onDelete: SetNull)

  @@unique([distributorId, productId])
  @@index([distributorId, isActive])
  @@index([productId])
  @@index([deletedAt])
  @@map("distributor_product")
}
