// ─────────────────────────────────────────────────────────────────────────────
// Hixaa DMS — foundation schema (Phase 1)
//
// Conventions (docs/02-data-model.md §0):
//   • PK          UUID v7 — time-sortable, so index locality matches insert order
//   • Timestamps  createdAt / updatedAt everywhere; deletedAt where soft-deletable
//   • Money       Decimal(18,4) — never float. See ADR-0004
//   • Naming      snake_case in Postgres, camelCase in Prisma via @map
//   • Enums       mirror @hixaa/contracts/enums exactly — one vocabulary
//
// Business domains (distributors, catalog, inventory, sales, finance) arrive in
// Phases 3–8. This file is the scaffolding they attach to.
// ─────────────────────────────────────────────────────────────────────────────

// No custom `output`: pnpm stores @prisma/client in the content-addressed
// store, and a custom output path generates the client somewhere the
// `@prisma/client` import cannot resolve. The default location is correct here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// ENUMS — mirror packages/contracts/src/enums.ts
// ═════════════════════════════════════════════════════════════════════════════

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ScopeType {
  GLOBAL
  TERRITORY
  DISTRIBUTOR
}

enum ActorType {
  USER
  SYSTEM
  API_KEY
}

enum AuditCategory {
  AUTH
  DATA
  SECURITY
  INTEGRATION
}

enum MfaType {
  TOTP
  BACKUP_CODE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum MailChannel {
  BUSINESS
  OPS
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum StorageProvider {
  LOCAL
  S3
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

enum DocumentVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NumberResetPolicy {
  NEVER
  YEARLY
  MONTHLY
}

// ═════════════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id String @id @default(uuid(7)) @db.Uuid

  // Stored lowercase (enforced by emailSchema in @hixaa/contracts) so a plain
  // unique index gives case-insensitive uniqueness without the citext extension.
  email        String  @unique
  passwordHash String? @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String?
  avatarUrl String? @map("avatar_url")

  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)

  // Auth hardening — see docs/06-security.md §3
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp         String?   @map("last_login_ip")

  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  isSystem Boolean @default(false) @map("is_system")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  roles                  UserRole[]
  sessions               Session[]
  mfaFactors             MfaFactor[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken[]
  teamMemberships        TeamMember[]
  managedTeams           Team[]                   @relation("TeamManager")
  managedTerritories     Territory[]              @relation("TerritoryManager")
  managedDistributors    Distributor[]            @relation("DistributorAccountManager")
  distributorNotes       DistributorNote[]        @relation("DistributorNoteAuthor")
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  apiKeys                ApiKey[]
  uploadedDocuments      Document[]
  reportDefinitions      ReportDefinition[]

  @@index([status, deletedAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("user")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique
  name        String
  description String?
  scopeType   ScopeType @default(GLOBAL) @map("scope_type")

  /// System roles are seeded and cannot be deleted or renamed.
  isSystem Boolean @default(false) @map("is_system")

  /// Approval hierarchy rank — a higher level may approve what a lower cannot.
  level Int @default(0)

  /// Monetary authority. Null means unlimited. See docs/04-rbac §4.
  maxDiscountPercent Decimal? @map("max_discount_percent") @db.Decimal(7, 4)
  maxOrderValue      Decimal? @map("max_order_value") @db.Decimal(18, 4)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("role")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// The join that carries the DATA BOUNDARY, not just the role. `scopeType` +
/// `scopeId` is the single mechanism that will make the v2 Distributor Portal
/// safe without a second auth system. See ADR-0003.
model UserRole {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  scopeType ScopeType @default(GLOBAL) @map("scope_type")
  /// Null when scopeType is GLOBAL; a territory or distributor id otherwise.
  scopeId   String?   @map("scope_id") @db.Uuid

  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  assignedById String?   @map("assigned_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@map("user_role")
}

/// Refresh-token lineage. `familyId` groups a rotation chain so that replaying a
/// rotated token can revoke the entire family. See docs/04-rbac §6.
model Session {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the opaque refresh token. The raw value is never stored.
  refreshTokenHash String  @unique @map("refresh_token_hash")
  familyId         String  @map("family_id") @db.Uuid
  replacedById     String? @map("replaced_by_id") @db.Uuid

  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")
  rememberMe Boolean @default(false) @map("remember_me")

  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  email     String
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_token")
}

model MfaFactor {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  type   MfaType @default(TOTP)

  /// AES-256-GCM encrypted at rest. See docs/06-security.md §7.
  secretEncrypted String   @map("secret_encrypted")
  /// Hashed single-use recovery codes.
  backupCodes     String[] @map("backup_codes")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factor")
}

model Team {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  managerId   String? @map("manager_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  manager User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members TeamMember[]

  @@index([deletedAt])
  @@map("team")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String @default("MEMBER")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

model ApiKey {
  id      String @id @default(uuid(7)) @db.Uuid
  name    String
  /// SHA-256 of the key. The raw value is shown once, at creation.
  keyHash String @unique @map("key_hash")
  prefix  String

  userId      String    @map("user_id") @db.Uuid
  permissions String[]
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_key")
}

// ═════════════════════════════════════════════════════════════════════════════
// AUDIT
// ═════════════════════════════════════════════════════════════════════════════

/// Append-only. The application database role is granted only INSERT and SELECT
/// on this table; no update or delete path exists in code.
/// Partitioned by month in production — see docs/02-data-model.md §10.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(USER) @map("actor_type")
  actorLabel  String?   @map("actor_label")

  category AuditCategory @default(DATA)
  action   String

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

// ═════════════════════════════════════════════════════════════════════════════
// TRANSACTIONAL OUTBOX — see ADR-0005
// ═════════════════════════════════════════════════════════════════════════════

/// Written inside the business transaction; published after commit by the
/// dispatcher worker. Guarantees no side effect is ever announced for a
/// transaction that rolled back, and keeps every third-party call off the
/// request path.
model OutboxEvent {
  id String @id @default(uuid(7)) @db.Uuid

  aggregateType String @map("aggregate_type")
  aggregateId   String @map("aggregate_id")
  eventType     String @map("event_type")

  payload Json

  status   OutboxStatus @default(PENDING)
  attempts Int          @default(0)

  /// Backoff target. The dispatcher only picks up rows whose time has come.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")

  actorUserId String? @map("actor_user_id") @db.Uuid
  requestId   String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // The dispatcher's poll. A partial index on this pair keeps the query fast
  // regardless of how large the processed history grows.
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// ═════════════════════════════════════════════════════════════════════════════
// MAIL & NOTIFICATIONS
// ═════════════════════════════════════════════════════════════════════════════

/// Every send is logged with its CHANNEL, so a business email appearing on the
/// ops transport (or vice versa) is visible in data as well as impossible in
/// types. See docs/07-integrations.md §1.
model EmailLog {
  id      String      @id @default(uuid(7)) @db.Uuid
  channel MailChannel

  toAddress String   @map("to_address")
  ccAddress String[] @map("cc_address")
  subject   String
  template  String

  status            EmailStatus @default(QUEUED)
  providerMessageId String?     @map("provider_message_id")
  attempts          Int         @default(0)
  error             String?
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([channel, status])
  @@index([toAddress])
  @@index([createdAt(sort: Desc)])
  @@map("email_log")
}

model Notification {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type     String
  title    String
  body     String
  data     Json?
  priority NotificationPriority @default(NORMAL)

  actionUrl String?   @map("action_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

model NotificationPreference {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  type   String

  channels NotificationChannel[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preference")
}

// ═════════════════════════════════════════════════════════════════════════════
// DOCUMENTS
// ═════════════════════════════════════════════════════════════════════════════

model Document {
  id String @id @default(uuid(7)) @db.Uuid

  storageKey String          @unique @map("storage_key")
  provider   StorageProvider @default(LOCAL)

  originalName   String @map("original_name")
  mimeType       String @map("mime_type")
  sizeBytes      BigInt @map("size_bytes")
  /// Integrity check and cheap deduplication key.
  checksumSha256 String @map("checksum_sha256")

  /// A document stays undownloadable until a scanner clears it. The NoOp driver
  /// marks SKIPPED in dev; ClamAV sets CLEAN or INFECTED in production.
  scanStatus ScanStatus @default(PENDING) @map("scan_status")
  scanEngine String?    @map("scan_engine")
  scannedAt  DateTime?  @map("scanned_at") @db.Timestamptz(3)

  visibility DocumentVisibility @default(INTERNAL)

  uploadedById String? @map("uploaded_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  uploadedBy   User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  links        DocumentLink[]
  kycRecords   DistributorDocument[]
  agreements   Agreement[]
  productMedia ProductMedia[]
  reportRuns   ReportRun[]

  @@index([checksumSha256])
  @@index([scanStatus])
  @@index([deletedAt])
  @@map("document")
}

/// Generic attachment join — lets any entity own documents without a foreign key
/// per owner type.
model DocumentLink {
  id         String @id @default(uuid(7)) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  entityType String  @map("entity_type")
  entityId   String  @map("entity_id") @db.Uuid
  purpose    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId, purpose])
  @@index([entityType, entityId])
  @@map("document_link")
}

// ═════════════════════════════════════════════════════════════════════════════
// SYSTEM
// ═════════════════════════════════════════════════════════════════════════════

/// How "nothing about the company is hardcoded" is honoured. Company profile,
/// branding, service lines, industries, approval ceilings, and feature flags all
/// live here — seeded on first boot, editable from the Admin Panel thereafter.
model SystemSetting {
  id       String @id @default(uuid(7)) @db.Uuid
  category String
  key      String
  value    Json

  description String?
  /// Secret values are redacted in API responses and never sent to Sheets.
  isSecret    Boolean @default(false) @map("is_secret")

  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([category, key])
  @@index([category])
  @@map("system_setting")
}

/// Gapless business number allocation. Consumed inside the same transaction as
/// the document it numbers, with SELECT … FOR UPDATE, so a rolled-back
/// transaction never burns a number. Critical for GST invoice series.
model NumberSequence {
  id     String @id @default(uuid(7)) @db.Uuid
  key    String @unique
  prefix String

  /// What joins the prefix to the counter — `HTPL/INV/2026-27` + `/` + `00001`.
  ///
  /// Per-sequence rather than hardcoded because the financial series use `/`
  /// (the format the CA expects — open question E2) while codes already issued
  /// under `DIST-00001` must keep their hyphen. A discontinuity WITHIN a series
  /// is what an auditor asks about; a difference between series is cosmetic.
  separator String @default("-")

  nextValue Int @default(1) @map("next_value")
  padding   Int @default(5)

  financialYear String?           @map("financial_year")
  resetPolicy   NumberResetPolicy @default(YEARLY) @map("reset_policy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("number_sequence")
}

/// Makes a retried money-moving POST safe. Same key + same body replays the
/// stored response; same key + different body is a 409.
model IdempotencyKey {
  id  String @id @default(uuid(7)) @db.Uuid
  key String

  userId      String @map("user_id") @db.Uuid
  endpoint    String
  requestHash String @map("request_hash")

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([key, userId, endpoint])
  @@index([expiresAt])
  @@map("idempotency_key")
}

model FeatureFlag {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  enabled     Boolean @default(false)
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flag")
}

// ═════════════════════════════════════════════════════════════════════════════
// GEOGRAPHY & TERRITORIES  (Phase 3)
// ═════════════════════════════════════════════════════════════════════════════

enum TerritoryType {
  ZONE
  REGION
  STATE
  DISTRICT
}

model Country {
  id       String @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-1 alpha-2.
  code     String @unique
  name     String
  dialCode String @map("dial_code")
  currency String

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  states State[]

  @@map("country")
}

/// The GST state code is the single most operationally important field in this
/// context: it is the input to the place-of-supply rule that decides whether a
/// line is taxed CGST+SGST or IGST. A wrong value produces legally defective
/// invoices. See docs/02-data-model.md §7.
model State {
  id               String  @id @default(uuid(7)) @db.Uuid
  countryId        String  @map("country_id") @db.Uuid
  name             String
  /// Postal abbreviation, e.g. MH.
  code             String
  /// Two-digit GST code, e.g. 27. Matches GSTIN characters 1–2.
  gstStateCode     String  @unique @map("gst_state_code")
  /// Union territories are taxed with UTGST rather than SGST.
  isUnionTerritory Boolean @default(false) @map("is_union_territory")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  country     Country     @relation(fields: [countryId], references: [id])
  cities      City[]
  addresses   Address[]
  territories Territory[]

  @@unique([countryId, code])
  @@index([countryId, isActive])
  @@map("state")
}

model City {
  id      String  @id @default(uuid(7)) @db.Uuid
  stateId String  @map("state_id") @db.Uuid
  name    String
  /// Optional default PIN, useful for address autocomplete.
  pincode String?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  state     State     @relation(fields: [stateId], references: [id])
  addresses Address[]

  @@unique([stateId, name])
  @@index([stateId, isActive])
  @@map("city")
}

/// Referenced by FK from its owners (warehouse, distributor, customer) rather
/// than being polymorphic — a real foreign key is enforceable and joinable;
/// an entityType/entityId pair is neither.
model Address {
  id       String  @id @default(uuid(7)) @db.Uuid
  label    String?
  line1    String
  line2    String?
  landmark String?

  cityId      String? @map("city_id") @db.Uuid
  cityName    String  @map("city_name")
  stateId     String  @map("state_id") @db.Uuid
  postalCode  String  @map("postal_code")
  countryCode String  @default("IN") @map("country_code")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  state State @relation(fields: [stateId], references: [id])
  city  City? @relation(fields: [cityId], references: [id])

  warehouses           Warehouse[]
  billingDistributors  Distributor[] @relation("DistributorBilling")
  shippingDistributors Distributor[] @relation("DistributorShipping")
  billingCustomers     Customer[]    @relation("CustomerBilling")
  shippingCustomers    Customer[]    @relation("CustomerShipping")

  @@index([stateId])
  @@index([postalCode])
  @@index([deletedAt])
  @@map("address")
}

/// Sales geography, as a tree: Zone → Region → State → District.
///
/// This is the FIRST scoped entity. Registering it in SCOPE_REGISTRY is what
/// makes the Prisma scope extension start filtering real rows — see ADR-0003.
model Territory {
  id       String        @id @default(uuid(7)) @db.Uuid
  code     String        @unique
  name     String
  type     TerritoryType @default(REGION)
  parentId String?       @map("parent_id") @db.Uuid

  /// Materialised path of ancestor ids, e.g. `.<zoneId>.<regionId>.`.
  ///
  /// Turns "everything under the West zone" into one indexed LIKE instead of a
  /// recursive CTE per request. Leading and trailing dots make `LIKE '%.<id>.%'`
  /// unambiguous — without them, one id could prefix-match another.
  path  String @default("")
  depth Int    @default(0)

  /// Optional link to a State, so a STATE-type territory inherits its GST code.
  stateId String? @map("state_id") @db.Uuid

  managerId   String? @map("manager_id") @db.Uuid
  description String?

  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  parent   Territory?  @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Territory[] @relation("TerritoryTree")
  state    State?      @relation(fields: [stateId], references: [id])
  manager  User?       @relation("TerritoryManager", fields: [managerId], references: [id], onDelete: SetNull)

  warehouses   Warehouse[]
  distributors Distributor[]
  customers    Customer[]
  salesTargets SalesTarget[]

  @@index([parentId])
  @@index([path])
  @@index([type, isActive])
  @@index([managerId])
  @@index([deletedAt])
  @@map("territory")
}

enum WarehouseType {
  COMPANY
  DISTRIBUTOR
  TRANSIT
  SCRAP
}

/// Introduced here because a warehouse is a location, and locations belong with
/// geography. The stock LEDGER that gives it meaning arrives in Phase 6.
model Warehouse {
  id   String        @id @default(uuid(7)) @db.Uuid
  code String        @unique
  name String
  type WarehouseType @default(COMPANY)

  addressId   String? @map("address_id") @db.Uuid
  territoryId String? @map("territory_id") @db.Uuid

  /// Set when type = DISTRIBUTOR. Phase 3 left this a plain column because the
  /// Distributor model did not exist yet; Phase 6 closed the seam and it is now
  /// a real FK.
  distributorId String? @map("distributor_id") @db.Uuid

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  address     Address?     @relation(fields: [addressId], references: [id])
  territory   Territory?   @relation(fields: [territoryId], references: [id])
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)

  // ── Inventory (Phase 6) ─────────────────────────────────────────────────
  ledgerEntries     StockLedgerEntry[]
  balances          StockBalance[]
  reservations      StockReservation[]
  serials           SerialNumber[]
  transfersOut      StockTransfer[]    @relation("TransferSource")
  transfersIn       StockTransfer[]    @relation("TransferDestination")
  inventorySettings InventorySetting[]
  stockCounts       StockCount[]
  orders            Order[]
  shipments         Shipment[]

  @@index([type, isActive])
  @@index([territoryId])
  @@index([distributorId])
  @@index([deletedAt])
  @@map("warehouse")
}

/// Industries Hixaa serves — thermal power, coal, mining, cement, rail
/// simulation. Promoted from a SystemSetting JSON blob to real rows now that
/// customers (Phase 7) will reference them by FK.
model Industry {
  id          String  @id @default(uuid(7)) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customers Customer[]

  @@map("industry")
}

// ═════════════════════════════════════════════════════════════════════════════
// DISTRIBUTORS — the channel  (Phase 5)
// ═════════════════════════════════════════════════════════════════════════════

enum DistributorType {
  DISTRIBUTOR
  DEALER
  SYSTEM_INTEGRATOR
  OEM_PARTNER
}

enum DistributorStatus {
  LEAD
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum KycDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  AGREEMENT
  CANCELLED_CHEQUE
  MSME_CERT
  OTHER
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/// A channel partner: distributor, dealer, system integrator, or OEM partner.
///
/// The SECOND scoped entity (after Territory). Registered in SCOPE_REGISTRY so
/// a territory-scoped user can only ever read the distributors in their own
/// subtree — see ADR-0003 and docs/15 §6.
model Distributor {
  id        String            @id @default(uuid(7)) @db.Uuid
  /// Human-readable, allocated from NumberSequence: DIST-00042.
  code      String            @unique
  legalName String            @map("legal_name")
  tradeName String?           @map("trade_name")
  type      DistributorType   @default(DISTRIBUTOR)
  status    DistributorStatus @default(LEAD)

  territoryId      String? @map("territory_id") @db.Uuid
  accountManagerId String? @map("account_manager_id") @db.Uuid

  /// Assigned price list. Phase 5 left this as a plain column because PriceList
  /// did not exist yet; Phase 4 closed the seam and it is now a real FK.
  /// `onDelete: Restrict` — a list with partners on it cannot be deleted out
  /// from under them, which would silently reprice every future order.
  priceListId String? @map("price_list_id") @db.Uuid

  billingAddressId  String? @map("billing_address_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  // ── Statutory identity ──────────────────────────────────────────────────
  /// Validated for format AND check digit before storage — a typo here
  /// produces a legally defective invoice that must be cancelled by credit note.
  gstin      String? @unique
  pan        String?
  tan        String?
  cin        String?
  msmeNumber String? @map("msme_number")

  // ── Commercial terms ────────────────────────────────────────────────────
  creditLimit      Decimal @default(0) @map("credit_limit") @db.Decimal(18, 4)
  creditDays       Int     @default(30) @map("credit_days")
  openingBalance   Decimal @default(0) @map("opening_balance") @db.Decimal(18, 4)
  paymentTermsCode String? @map("payment_terms_code")

  // ── Banking. The account number is encrypted at rest (AES-256-GCM). ──────
  bankAccountName      String? @map("bank_account_name")
  bankAccountEncrypted String? @map("bank_account_encrypted")
  bankIfsc             String? @map("bank_ifsc")
  bankName             String? @map("bank_name")

  website String?
  tags    String[]

  onboardedAt  DateTime? @map("onboarded_at") @db.Timestamptz(3)
  suspendedAt  DateTime? @map("suspended_at") @db.Timestamptz(3)
  statusReason String?   @map("status_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  territory       Territory? @relation(fields: [territoryId], references: [id])
  accountManager  User?      @relation("DistributorAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  billingAddress  Address?   @relation("DistributorBilling", fields: [billingAddressId], references: [id])
  shippingAddress Address?   @relation("DistributorShipping", fields: [shippingAddressId], references: [id])

  priceList PriceList? @relation(fields: [priceListId], references: [id], onDelete: Restrict)

  contacts           DistributorContact[]
  documents          DistributorDocument[]
  notes              DistributorNote[]
  agreements         Agreement[]
  /// The authorized catalog — which products this partner may buy (Phase 4).
  authorizedProducts DistributorProduct[]
  /// Distributor-owned warehouses, and the serials shipped to this partner.
  warehouses         Warehouse[]
  serials            SerialNumber[]
  // ── Sales (Phase 7) ─────────────────────────────────────────────────────
  customers          Customer[]
  quotations         Quotation[]
  orders             Order[]
  // ── Finance (Phase 8) ───────────────────────────────────────────────────
  invoices           Invoice[]
  payments           Payment[]
  ledgerEntries      LedgerEntry[]
  // ── Intelligence (Phase 9) ──────────────────────────────────────────────
  salesTargets       SalesTarget[]

  @@index([status, territoryId])
  @@index([priceListId])
  @@index([accountManagerId])
  @@index([territoryId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("distributor")
}

model DistributorContact {
  id            String @id @default(uuid(7)) @db.Uuid
  distributorId String @map("distributor_id") @db.Uuid

  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false) @map("is_primary")

  /// The seam for the v2 Distributor Portal: onboarding a distributor user is
  /// creating a User and linking it here, not building a second auth system.
  portalUserId String? @map("portal_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([portalUserId])
  @@map("distributor_contact")
}

/// KYC. A distributor cannot be approved until the required types are verified.
model DistributorDocument {
  id            String          @id @default(uuid(7)) @db.Uuid
  distributorId String          @map("distributor_id") @db.Uuid
  documentId    String          @map("document_id") @db.Uuid
  type          KycDocumentType

  /// Certificates expire; an expiry sweep warns before they lapse.
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedById    String?   @map("verified_by_id") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id])

  @@unique([distributorId, type, documentId])
  @@index([distributorId, type])
  @@index([expiresAt])
  @@map("distributor_document")
}

model DistributorNote {
  id            String  @id @default(uuid(7)) @db.Uuid
  distributorId String  @map("distributor_id") @db.Uuid
  authorId      String? @map("author_id") @db.Uuid
  body          String
  isPinned      Boolean @default(false) @map("is_pinned")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  author      User?       @relation("DistributorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([distributorId, isPinned, createdAt(sort: Desc)])
  @@map("distributor_note")
}

model Agreement {
  id            String          @id @default(uuid(7)) @db.Uuid
  distributorId String          @map("distributor_id") @db.Uuid
  reference     String?
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime?       @map("end_date") @db.Date
  targetAmount  Decimal?        @map("target_amount") @db.Decimal(18, 4)
  status        AgreementStatus @default(DRAFT)
  documentId    String?         @map("document_id") @db.Uuid
  notes         String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id])

  @@index([distributorId, status])
  @@index([endDate])
  @@map("agreement")
}

// ═════════════════════════════════════════════════════════════════════════════
// CATALOG & PRICING (Phase 4)
//
// Shaped by the single most important domain fact: Hixaa sells SYSTEMS, not
// SKUs. A Raksha IoT deployment is gateways + tags + a licence + commissioning,
// and commissioning is a SERVICE carrying a SAC code on the same invoice as the
// goods. Hence four product types, a bill of materials, specifications as rows,
// and HSN alongside SAC. See docs/00-domain-and-scope.md §1.1 and docs/17.
// ═════════════════════════════════════════════════════════════════════════════

enum ProductType {
  GOODS
  SERVICE
  KIT
  CONFIGURABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

enum ProductMediaType {
  IMAGE
  BROCHURE
  DATASHEET
  MANUAL
  CERTIFICATE
  VIDEO
  CAD
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Whether a list's prices include tax. Stored explicitly rather than assumed:
/// a column of numbers carries no memory of which convention produced it.
/// Hixaa quotes ex-GST — see ADR-0008.
enum PriceBasis {
  EXCLUSIVE
  INCLUSIVE
}

enum DiscountScope {
  GLOBAL
  PRICE_LIST
  DISTRIBUTOR
  CATEGORY
  PRODUCT
}

enum DiscountType {
  PERCENT
  FLAT
}

/// Unit of measure, carrying the GST-mandated **UQC** code.
///
/// A separate table rather than a free-text column because UQC is validated when
/// GSTR-1 is filed: "pieces" is rejected where `NOS` is required, and finding
/// that out at filing time means re-issuing invoices.
model UnitOfMeasure {
  id        String  @id @default(uuid(7)) @db.Uuid
  code      String  @unique
  name      String
  /// The GST Unit Quantity Code — NOS, SET, MTR, KGS, HRS…
  uqc       String
  /// Decimal places allowed. 0 for NOS: half a gateway is not a thing.
  precision Int     @default(0)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@map("unit_of_measure")
}

/// Hixaa's own brand plus the OEM brands it integrates and resells.
model Brand {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique
  name String
  slug String @unique

  description    String?
  website        String?
  logoDocumentId String? @map("logo_document_id") @db.Uuid
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("brand")
}

/// Nested product categories, seeded from the company's published service lines.
///
/// Uses the SAME materialised-path scheme as Territory, and the same helpers in
/// `modules/territories/territory-path.ts` — a second tree does not need a
/// second implementation, and sharing the code means the cycle guard and the
/// subtree rewrite are already proven.
model Category {
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String  @unique
  name     String
  slug     String  @unique
  parentId String? @map("parent_id") @db.Uuid

  /// `.<ancestorId>.<selfId>.` — leading and trailing dots are load-bearing.
  path  String @default("")
  depth Int    @default(0)

  description     String?
  /// Display order among siblings.
  sortOrder       Int     @default(0) @map("sort_order")
  imageDocumentId String? @map("image_document_id") @db.Uuid
  isActive        Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([path])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("category")
}

/// The catalog's central entity.
model Product {
  id     String        @id @default(uuid(7)) @db.Uuid
  sku    String        @unique
  name   String
  slug   String        @unique
  type   ProductType   @default(GOODS)
  status ProductStatus @default(DRAFT)

  categoryId String? @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid
  uomId      String? @map("uom_id") @db.Uuid

  shortDescription String? @map("short_description")
  description      String?

  // ── Tax classification ──────────────────────────────────────────────────
  /// HSN classifies GOODS, SAC classifies SERVICES. A product carries exactly
  /// one — enforced by a CHECK constraint in migration 0006, because a service
  /// invoiced under an HSN code is a filing defect.
  hsnCode String? @map("hsn_code")
  sacCode String? @map("sac_code")
  /// Denormalised snapshot for list display ONLY. `tax_rate` is authoritative —
  /// it is date-effective, and this column is not. See ADR-0008 §2.
  gstRate Decimal @default(18) @map("gst_rate") @db.Decimal(5, 2)

  // ── Physical and commercial attributes ──────────────────────────────────
  /// An IoT safety device in a confined space is a warranty and liability
  /// object: we must be able to say which serial went where. Drives the serial
  /// ledger in Phase 6.
  isSerialized   Boolean @default(false) @map("is_serialized")
  isBatchTracked Boolean @default(false) @map("is_batch_tracked")
  isReturnable   Boolean @default(true) @map("is_returnable")
  isPurchasable  Boolean @default(true) @map("is_purchasable")
  isSellable     Boolean @default(true) @map("is_sellable")

  warrantyMonths Int?     @map("warranty_months")
  leadTimeDays   Int?     @map("lead_time_days")
  minOrderQty    Decimal  @default(1) @map("min_order_qty") @db.Decimal(18, 4)
  weightGrams    Decimal? @map("weight_grams") @db.Decimal(18, 4)

  tags String[]

  /// Postgres-generated tsvector over name, SKU, description and tags, with a
  /// GIN index. Generated columns are not expressible in Prisma, so it is
  /// declared Unsupported here and created in migration 0006 — which also means
  /// Prisma never tries to write it, which is exactly right.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Incremented on every commercially significant change; a quotation issued
  /// against revision 3 stays explicable after revision 4 lands.
  revision Int @default(1)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  uom      UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: Restrict)

  variants       ProductVariant[]
  specifications ProductSpecification[]
  media          ProductMedia[]
  revisions      ProductRevision[]
  /// This product's own components…
  bomComponents  ProductBom[]           @relation("BomParent")
  /// …and the assemblies this product is a component of.
  bomUsedIn      ProductBom[]           @relation("BomComponent")
  priceListItems PriceListItem[]
  authorizedFor  DistributorProduct[]

  // ── Inventory (Phase 6) ─────────────────────────────────────────────────
  batches           Batch[]
  ledgerEntries     StockLedgerEntry[]
  balances          StockBalance[]
  reservations      StockReservation[]
  serials           SerialNumber[]
  transferLines     StockTransferLine[]
  inventorySettings InventorySetting[]
  stockCountLines   StockCountLine[]
  // ── Sales (Phase 7) ─────────────────────────────────────────────────────
  quotationLines    QuotationLine[]
  orderLines        OrderLine[]
  // ── Finance (Phase 8) ───────────────────────────────────────────────────
  invoiceLines      InvoiceLine[]
  taxNoteLines      TaxNoteLine[]
  // ── Intelligence (Phase 9) ──────────────────────────────────────────────
  salesTargets      SalesTarget[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([type, status])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([hsnCode])
  @@index([sacCode])
  @@index([deletedAt])
  // Declared HERE rather than only in raw SQL. An index Prisma does not know
  // about is one the next `migrate dev` diff proposes DROPPING — it compares
  // the whole database against this file. Partial indexes escape that (Prisma
  // skips what it cannot model), which is why migration 0002's survived and
  // these three would not have. See HANDOFF §4.13.
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin, map: "product_search_vector_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_sku_trgm_idx")
  @@map("product")
}

/// A concrete sellable configuration of a CONFIGURABLE product.
model ProductVariant {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  sku       String @unique
  name      String

  /// The distinguishing attributes, e.g. `{ "range": "50 workers" }`. JSON is
  /// right here (unlike specifications): these are identity, not filter targets.
  attributes Json @default("{}")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceListItems PriceListItem[]

  // ── Inventory (Phase 6) ─────────────────────────────────────────────────
  ledgerEntries   StockLedgerEntry[]
  balances        StockBalance[]
  reservations    StockReservation[]
  transferLines   StockTransferLine[]
  stockCountLines StockCountLine[]
  quotationLines  QuotationLine[]
  orderLines      OrderLine[]
  invoiceLines    InvoiceLine[]

  @@index([productId, isActive])
  @@index([deletedAt])
  @@map("product_variant")
}

/// Technical specifications as ROWS, not a JSON blob.
///
/// Industrial buyers filter on specifications — "DAQ modules with 24 V DC
/// supply" is a real query this catalog must answer. JSON cannot be indexed for
/// that anywhere near as cheaply. See docs/02-data-model.md §4.
model ProductSpecification {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Groups specs on the datasheet: "Electrical", "Environmental", "Physical".
  groupName String? @map("group_name")
  name      String
  value     String
  unit      String?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([name, value])
  @@map("product_specification")
}

/// Links a product to an already-uploaded Document. Deliberately does not
/// re-implement upload, scanning, or storage — DocumentsService owns all three.
model ProductMedia {
  id         String           @id @default(uuid(7)) @db.Uuid
  productId  String           @map("product_id") @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  type       ProductMediaType @default(IMAGE)

  title     String?
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([productId, documentId, type])
  @@index([productId, type, sortOrder])
  @@map("product_media")
}

/// Bill of materials — what a KIT explodes into.
///
/// This is what makes "Raksha IoT — 50-Worker Deployment" one sellable line that
/// resolves to gateways, wearable tags, a server licence, and commissioning.
model ProductBom {
  id                 String @id @default(uuid(7)) @db.Uuid
  parentProductId    String @map("parent_product_id") @db.Uuid
  componentProductId String @map("component_product_id") @db.Uuid

  quantity   Decimal @db.Decimal(18, 4)
  /// Optional components appear in the explosion but priced at zero unless
  /// selected — how "add a spare gateway" is modelled without a second SKU.
  isOptional Boolean @default(false) @map("is_optional")
  sortOrder  Int     @default(0) @map("sort_order")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent    Product @relation("BomParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  component Product @relation("BomComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  /// A component appears at most once per parent; change the quantity instead.
  @@unique([parentProductId, componentProductId])
  @@index([componentProductId])
  @@map("product_bom")
}

/// Append-only snapshot of a product's commercially significant fields.
///
/// Never updated, never deleted — hence no `deletedAt`, the same reasoning that
/// keeps invoices out of the soft-delete extension.
model ProductRevision {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  revision  Int

  /// The full before-image at the moment of change.
  snapshot  Json
  changedBy String? @map("changed_by") @db.Uuid
  reason    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, revision])
  @@index([productId, createdAt(sort: Desc)])
  @@map("product_revision")
}

/// A named, date-effective set of prices assigned to distributors.
///
/// Versioned by CLONING rather than editing: republishing a live list would
/// silently reprice every order still being negotiated against it.
model PriceList {
  id     String          @id @default(uuid(7)) @db.Uuid
  code   String          @unique
  name   String
  status PriceListStatus @default(DRAFT)

  currency   String     @default("INR") @db.Char(3)
  /// ADR-0008: Hixaa quotes ex-GST. Stored, not assumed.
  priceBasis PriceBasis @default(EXCLUSIVE) @map("price_basis")

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  /// Exactly one list may be the default, enforced by a PARTIAL unique index in
  /// migration 0006 — a plain unique would allow only one `false` row.
  isDefault Boolean @default(false) @map("is_default")

  version      Int     @default(1)
  clonedFromId String? @map("cloned_from_id") @db.Uuid
  description  String?

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  clonedFrom PriceList?  @relation("PriceListVersions", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones     PriceList[] @relation("PriceListVersions")

  items        PriceListItem[]
  distributors Distributor[]
  customFor    DistributorProduct[]

  @@index([status, validFrom])
  @@index([deletedAt])
  @@map("price_list")
}

/// One price point. The `minQty` column IS the volume slab: rows at 1 / 10 / 50
/// for one product are three slabs, and resolution takes the highest `minQty`
/// that does not exceed the ordered quantity.
model PriceListItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  priceListId String  @map("price_list_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid

  /// Lower bound of the slab, inclusive.
  minQty Decimal @default(1) @map("min_qty") @db.Decimal(18, 4)
  /// GST-EXCLUSIVE unit price. See ADR-0008.
  price  Decimal @db.Decimal(18, 4)

  /// Floor below which the pricing engine flags an override as needing
  /// approval, independent of the caller's role ceiling. Null means no floor.
  minPrice Decimal? @map("min_price") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceList PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Uniqueness is enforced by two PARTIAL indexes in migration 0006 rather than
  /// here: Postgres treats NULLs as distinct, so a plain unique on a nullable
  /// `variant_id` would happily accept duplicate product-level slabs.
  @@index([priceListId, productId, minQty(sort: Desc)])
  @@index([productId])
  @@map("price_list_item")
}

/// A discount that may apply to a line. Rules do NOT stack — the highest
/// priority wins and the rest are reported as considered-and-rejected. See
/// ADR-0007 §3 for why.
model DiscountRule {
  id    String        @id @default(uuid(7)) @db.Uuid
  code  String        @unique
  name  String
  scope DiscountScope @default(GLOBAL)

  /// The scoped entity's id — a product, category, distributor, or price list.
  /// Polymorphic, so no FK is possible; the service validates existence against
  /// the scope on write, which is where the type is actually known.
  targetId String? @map("target_id") @db.Uuid

  type  DiscountType @default(PERCENT)
  /// A percentage (0–100) when type is PERCENT, else an absolute amount.
  value Decimal      @db.Decimal(18, 4)

  minQty            Decimal? @map("min_qty") @db.Decimal(18, 4)
  minAmount         Decimal? @map("min_amount") @db.Decimal(18, 4)
  /// Caps a PERCENT discount in absolute terms. Null means uncapped.
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(18, 4)

  /// Lower number wins. Ties break on scope specificity (PRODUCT first).
  priority Int @default(100)

  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  isActive  Boolean   @default(true) @map("is_active")

  description String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  @@index([isActive, scope, targetId])
  @@index([validFrom, validTo])
  @@index([deletedAt])
  @@map("discount_rule")
}

/// Date-effective GST rates by HSN/SAC. A rate change is an INSERT; historical
/// invoices resolve the rate in force on their own document date and stay
/// permanently reproducible. See ADR-0008 §2.
model TaxRate {
  id         String @id @default(uuid(7)) @db.Uuid
  hsnSacCode String @map("hsn_sac_code")

  /// Total GST percentage. The CGST/SGST split is derived (half each) rather
  /// than stored, because the split is a property of the TRANSACTION's
  /// geography, not of the rate.
  gstRate  Decimal @map("gst_rate") @db.Decimal(5, 2)
  cessRate Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)

  description String?

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  /// One rate per code per start date. Superseding means inserting a new row
  /// and closing the old one's `effectiveTo`, never editing.
  @@unique([hsnSacCode, effectiveFrom])
  @@index([hsnSacCode, effectiveFrom(sort: Desc)])
  @@map("tax_rate")
}

/// The authorized catalog — which products a distributor may buy.
///
/// Closes the second seam Phase 5 left open. This is the ONLY Phase 4 model
/// that is scope-sensitive: it is registered in SCOPE_REGISTRY as
/// `viaDistributor()`, so a territory-scoped user cannot read or write the
/// commercial terms of a partner outside their subtree. The rest of the catalog
/// is company-wide reference data and is deliberately unscoped.
model DistributorProduct {
  id            String @id @default(uuid(7)) @db.Uuid
  distributorId String @map("distributor_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid

  /// Overrides the distributor's assigned list for this product alone — the
  /// bespoke-terms escape hatch, without cloning a whole list for one SKU.
  customPriceListId String? @map("custom_price_list_id") @db.Uuid

  isActive     Boolean  @default(true) @map("is_active")
  authorizedAt DateTime @default(now()) @map("authorized_at") @db.Timestamptz(3)
  /// Ceiling on how much of this product the partner may order at once. Null
  /// means unlimited. Enforced by the order module in Phase 7.
  maxOrderQty  Decimal? @map("max_order_qty") @db.Decimal(18, 4)
  notes        String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  distributor     Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customPriceList PriceList?  @relation(fields: [customPriceListId], references: [id], onDelete: SetNull)

  @@unique([distributorId, productId])
  @@index([distributorId, isActive])
  @@index([productId])
  @@index([deletedAt])
  @@map("distributor_product")
}

// ═════════════════════════════════════════════════════════════════════════════
// INVENTORY (Phase 6)
//
// A LEDGER plus a DERIVED BALANCE, never a mutable counter. See ADR-0002.
//
// The rule that governs every model below: `stock_ledger_entry` is the source of
// truth and is append-only; `stock_balance` is a read-model maintained in the
// SAME transaction under `SELECT ... FOR UPDATE`. Nothing outside
// StockLedgerService.move() may write either table. See docs/19 §3.
// ═════════════════════════════════════════════════════════════════════════════

enum StockMovementType {
  OPENING
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  SALES_RETURN
  SCRAP
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RMA
  SCRAPPED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  COUNTING
  POSTED
  CANCELLED
}

/// Manufacturing lot. Only meaningful for products with `isBatchTracked`.
model Batch {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  lotNumber String @map("lot_number")

  manufacturedOn DateTime? @map("manufactured_on") @db.Date
  expiresOn      DateTime? @map("expires_on") @db.Date
  notes          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerEntries StockLedgerEntry[]
  balances      StockBalance[]

  @@unique([productId, lotNumber])
  @@index([expiresOn])
  @@map("batch")
}

/// The immutable, append-only record of every stock movement.
///
/// THE SOURCE OF TRUTH. "Why is stock 47?" is answered by reading this table,
/// not by guessing. Adjustments are new compensating rows, never edits — which
/// is why there is no `deletedAt` and no `updatedAt` here, and why a database
/// trigger blocks UPDATE and DELETE outright (migration 0007).
model StockLedgerEntry {
  id          String  @id @default(uuid(7)) @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid

  movementType StockMovementType @map("movement_type")

  /// SIGNED: positive in, negative out. Storing the sign rather than a separate
  /// direction column means a balance is a plain SUM() and cannot be summed
  /// wrongly.
  quantity Decimal @db.Decimal(18, 4)

  /// The cost per unit AT THIS MOMENT. Held per row so a restated running
  /// average can never rewrite history — COGS for a past period is read from
  /// here, not recomputed from today's average. See ADR-0010 §3.
  unitCost Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)

  /// What caused the movement: ORDER, SHIPMENT, TRANSFER, ADJUSTMENT, COUNT.
  /// Deliberately polymorphic — the ledger must not grow a foreign key every
  /// time a new document type can move stock.
  refType String? @map("ref_type")
  refId   String? @map("ref_id") @db.Uuid
  /// Mandatory on ADJUSTMENT and SCRAP: an unexplained stock change is
  /// indistinguishable from theft.
  reason  String?

  /// When the movement physically happened, which is not always when it was
  /// recorded — a backdated goods receipt is a real thing.
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch     Batch?          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([warehouseId, productId, occurredAt(sort: Desc)])
  @@index([productId, occurredAt(sort: Desc)])
  @@index([refType, refId])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("stock_ledger_entry")
}

/// The derived read-model. NEVER written except by StockLedgerService.move().
///
/// Exists because `SUM()` over millions of ledger rows on every product page is
/// not viable at the stated scale. Its correctness is guaranteed by being
/// written in the same transaction as the ledger row, under a row lock, and
/// re-derived nightly by the reconciliation job.
model StockBalance {
  id          String  @id @default(uuid(7)) @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid

  quantityOnHand   Decimal @default(0) @map("quantity_on_hand") @db.Decimal(18, 4)
  /// Committed to an approved order but not yet physically issued. Reserved
  /// stock is still ON HAND — it has not moved anywhere.
  quantityReserved Decimal @default(0) @map("quantity_reserved") @db.Decimal(18, 4)

  /// `on_hand - reserved`, a GENERATED column created in migration 0007.
  /// Generated rather than maintained: a derived value that can be written to
  /// will eventually be written to incorrectly.
  quantityAvailable Decimal? @map("quantity_available") @db.Decimal(18, 4)

  /// Moving weighted average, recomputed on inbound movements only (ADR-0010).
  averageCost Decimal @default(0) @map("average_cost") @db.Decimal(18, 4)

  lastMovementAt DateTime? @map("last_movement_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batch     Batch?          @relation(fields: [batchId], references: [id], onDelete: Restrict)

  /// Uniqueness is enforced by PARTIAL indexes in migration 0007 — `variant_id`
  /// and `batch_id` are nullable, and Postgres treats NULLs as distinct, so a
  /// plain unique would permit duplicate balance rows for the same product.
  /// Two balance rows for one product is silent, permanent corruption.
  @@index([warehouseId, productId])
  @@index([productId])
  /// Declared here, not only in raw SQL — see the Product model's note and
  /// HANDOFF §4.13. Drives the low-stock query.
  @@index([productId, quantityAvailable])
  @@map("stock_balance")
}

/// Stock committed to an approved order but not yet issued.
///
/// Phase 7 owns the triggers (approve → reserve, cancel → release, dispatch →
/// consume); Phase 6 owns the operations and their correctness.
model StockReservation {
  id          String  @id @default(uuid(7)) @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid

  /// The order this is held for. Phase 6 left this a plain column because Order
  /// did not exist yet; Phase 7 closed the seam and it is now a real FK. This
  /// was the last open seam in the schema.
  orderId String? @map("order_id") @db.Uuid

  quantity Decimal           @db.Decimal(18, 4)
  status   ReservationStatus @default(ACTIVE)

  /// Stale reservations are expired by the maintenance job so stock does not
  /// stay locked behind an order nobody is progressing.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  notes      String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([warehouseId, productId, status])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("stock_reservation")
}

/// A physical unit's identity, created AT DISPATCH. See ADR-0009.
///
/// The liability object: given a serial, we can name the distributor, the
/// customer, the dispatch date, and the warranty expiry. That is what a field
/// incident on a confined-space safety device actually needs.
model SerialNumber {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  serial    String @unique

  status SerialStatus @default(SOLD)

  /// Null once dispatched — the unit is no longer in a Hixaa warehouse.
  warehouseId String? @map("warehouse_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid

  currentDistributorId String? @map("current_distributor_id") @db.Uuid
  /// Set when the distributor reports the sell-out (Phase 7).
  currentCustomerId    String? @map("current_customer_id") @db.Uuid

  /// Opened at DISPATCH, not at receipt: a buyer's warranty should not be
  /// eroded by however long the unit sat on Hixaa's shelf.
  warrantyStart DateTime? @map("warranty_start") @db.Date
  warrantyEnd   DateTime? @map("warranty_end") @db.Date

  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  notes        String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse          Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  currentDistributor Distributor? @relation(fields: [currentDistributorId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([currentDistributorId])
  @@index([warrantyEnd])
  @@map("serial_number")
}

/// Movement between warehouses, in two phases.
///
/// Stock sits in a TRANSIT warehouse between dispatch and receipt so it is
/// VISIBLE rather than missing. A single-phase transfer makes goods vanish for
/// however long the lorry takes, and every such gap gets reported as a bug.
model StockTransfer {
  id     String         @id @default(uuid(7)) @db.Uuid
  code   String         @unique
  status TransferStatus @default(DRAFT)

  sourceWarehouseId      String  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String  @map("destination_warehouse_id") @db.Uuid
  /// Where stock rests in between. Null falls back to the source, which keeps
  /// the transfer usable before a TRANSIT warehouse has been configured.
  transitWarehouseId     String? @map("transit_warehouse_id") @db.Uuid

  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  receivedAt   DateTime? @map("received_at") @db.Timestamptz(3)
  notes        String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  source      Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destination Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  lines       StockTransferLine[]

  @@index([status, createdAt(sort: Desc)])
  @@index([sourceWarehouseId])
  @@index([deletedAt])
  @@map("stock_transfer")
}

model StockTransferLine {
  id         String  @id @default(uuid(7)) @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid

  quantity         Decimal  @db.Decimal(18, 4)
  /// Short receipts are normal — damage, miscount. Recorded rather than
  /// silently reconciled, so the difference is investigable.
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(18, 4)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId, variantId])
  @@index([productId])
  @@map("stock_transfer_line")
}

/// Per-warehouse reorder policy. Drives the low-stock alert.
model InventorySetting {
  id          String @id @default(uuid(7)) @db.Uuid
  productId   String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  reorderLevel    Decimal  @default(0) @map("reorder_level") @db.Decimal(18, 4)
  reorderQuantity Decimal  @default(0) @map("reorder_quantity") @db.Decimal(18, 4)
  maxLevel        Decimal? @map("max_level") @db.Decimal(18, 4)
  alertEnabled    Boolean  @default(true) @map("alert_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId, alertEnabled])
  @@map("inventory_setting")
}

/// A physical stock take. Variances post as ADJUSTMENT movements through the
/// same `move()` path as everything else, so a count cannot bypass the ledger.
model StockCount {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      StockCountStatus @default(DRAFT)

  countedOn DateTime  @map("counted_on") @db.Date
  postedAt  DateTime? @map("posted_at") @db.Timestamptz(3)
  notes     String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  postedById  String?   @map("posted_by_id") @db.Uuid

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines     StockCountLine[]

  @@index([warehouseId, status])
  @@index([deletedAt])
  @@map("stock_count")
}

model StockCountLine {
  id           String  @id @default(uuid(7)) @db.Uuid
  stockCountId String  @map("stock_count_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  variantId    String? @map("variant_id") @db.Uuid

  /// What the system believed at the moment the count sheet was generated.
  systemQuantity  Decimal  @map("system_quantity") @db.Decimal(18, 4)
  /// What was physically found. Null until counted.
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(18, 4)
  reason          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockCount StockCount      @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId, variantId])
  @@map("stock_count_line")
}

// ═════════════════════════════════════════════════════════════════════════════
// SALES (Phase 7)
//
// Where the pricing engine (ADR-0007) and the stock ledger (ADR-0002) meet.
// Nothing here reimplements either: a price comes from PricingService.quote()
// and stock moves through StockLedgerService / ReservationsService.
//
// The governing rule for every line below is ADR-0011: a line stores the
// RESOLVED commercial figures, not the inputs that produced them. Every input
// to a price is mutable by design — price lists are cloned, discount rules
// expire, GST rates change — so an order re-priced against today's data is not
// the order the customer agreed to.
// ═════════════════════════════════════════════════════════════════════════════

enum CustomerType {
  INDUSTRIAL
  GOVERNMENT
  OEM
  INSTITUTIONAL
  INDIVIDUAL
}

enum OrderType {
  PRIMARY
  SECONDARY
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ShipmentStatus {
  PENDING
  PACKED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

/// What an approval was granted against, so a decision is explicable later.
enum ApprovalKind {
  DISCOUNT
  ORDER_VALUE
  CREDIT_LIMIT
}

/// An end customer: a plant, a mine, a government body. Distinct from a
/// Distributor, which is a channel partner. A SECONDARY (sell-out) order is
/// distributor → customer; a PRIMARY order is Hixaa → distributor.
model Customer {
  id   String       @id @default(uuid(7)) @db.Uuid
  code String       @unique
  name String
  type CustomerType @default(INDUSTRIAL)

  /// Which distributor services this customer, if any. Sell-out is reported
  /// against the pair.
  distributorId String? @map("distributor_id") @db.Uuid
  territoryId   String? @map("territory_id") @db.Uuid
  industryId    String? @map("industry_id") @db.Uuid

  gstin String?
  pan   String?

  billingAddressId  String? @map("billing_address_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  /// The plant or site, where that differs from the billing entity — a single
  /// power utility may have many.
  siteName String?  @map("site_name")
  website  String?
  notes    String?
  tags     String[]

  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  distributor     Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  territory       Territory?   @relation(fields: [territoryId], references: [id])
  industry        Industry?    @relation(fields: [industryId], references: [id])
  billingAddress  Address?     @relation("CustomerBilling", fields: [billingAddressId], references: [id])
  shippingAddress Address?     @relation("CustomerShipping", fields: [shippingAddressId], references: [id])

  contacts      CustomerContact[]
  quotations    Quotation[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]

  @@index([territoryId, isActive])
  @@index([distributorId])
  @@index([industryId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("customer")
}

model CustomerContact {
  id          String  @id @default(uuid(7)) @db.Uuid
  customerId  String  @map("customer_id") @db.Uuid
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false) @map("is_primary")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([deletedAt])
  @@map("customer_contact")
}

/// A priced proposal. Hixaa's motion begins here, not at a reorder.
model Quotation {
  id     String          @id @default(uuid(7)) @db.Uuid
  number String          @unique
  status QuotationStatus @default(DRAFT)

  /// Revisions share a group id, so "quotation QT/2026-27/00042 rev 3" is one
  /// conversation rather than three unrelated documents.
  groupId  String @map("group_id") @db.Uuid
  revision Int    @default(1)

  distributorId String? @map("distributor_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  /// Place of supply decides the CGST/SGST vs IGST split (ADR-0008). Snapshotted
  /// because a customer's address can change after the quote is sent.
  placeOfSupplyStateCode String? @map("place_of_supply_state_code")
  priceListId            String? @map("price_list_id") @db.Uuid

  quotationDate DateTime  @map("quotation_date") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date

  // ── Totals, snapshotted (ADR-0011) ──────────────────────────────────────
  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  totalDiscount Decimal @default(0) @map("total_discount") @db.Decimal(18, 4)
  taxableValue  Decimal @default(0) @map("taxable_value") @db.Decimal(18, 4)
  totalCgst     Decimal @default(0) @map("total_cgst") @db.Decimal(18, 4)
  totalSgst     Decimal @default(0) @map("total_sgst") @db.Decimal(18, 4)
  totalIgst     Decimal @default(0) @map("total_igst") @db.Decimal(18, 4)
  totalTax      Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundOff      Decimal @default(0) @map("round_off") @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)

  termsAndConditions String? @map("terms_and_conditions")
  notes              String?

  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  lines  QuotationLine[]
  orders Order[]

  @@index([status, quotationDate(sort: Desc)])
  @@index([distributorId])
  @@index([customerId])
  @@index([groupId, revision])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("quotation")
}

/// One quoted line, carrying the RESOLVED price rather than a reference to it.
/// See ADR-0011 for why every one of these columns is stored and not derived.
model QuotationLine {
  id          String @id @default(uuid(7)) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  lineNumber  Int    @map("line_number")

  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  /// Snapshotted: a product renamed later must not rewrite a document the
  /// customer already holds.
  sku             String
  description     String
  /// Which revision of the product this was quoted against.
  productRevision Int    @default(1) @map("product_revision")

  quantity Decimal @db.Decimal(18, 4)
  uomCode  String? @map("uom_code")

  unitListPrice   Decimal @map("unit_list_price") @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)
  discountRuleId  String? @map("discount_rule_id") @db.Uuid
  /// Mandatory when the price was overridden (ADR-0007 §4).
  overrideReason  String? @map("override_reason")

  taxableValue Decimal @map("taxable_value") @db.Decimal(18, 4)
  hsnSacCode   String? @map("hsn_sac_code")
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 4)
  sgst         Decimal @default(0) @db.Decimal(18, 4)
  igst         Decimal @default(0) @db.Decimal(18, 4)
  cess         Decimal @default(0) @db.Decimal(18, 4)
  totalTax     Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(18, 4)

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNumber])
  @@index([productId])
  @@map("quotation_line")
}

/// A committed order. PRIMARY is Hixaa → distributor; SECONDARY is the
/// distributor's own sell-out to an end customer.
model Order {
  id     String      @id @default(uuid(7)) @db.Uuid
  number String      @unique
  type   OrderType   @default(PRIMARY)
  status OrderStatus @default(DRAFT)

  distributorId String? @map("distributor_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid
  quotationId   String? @map("quotation_id") @db.Uuid
  /// Which warehouse fulfils this order. Reservations are taken here.
  warehouseId   String? @map("warehouse_id") @db.Uuid

  placeOfSupplyStateCode String? @map("place_of_supply_state_code")
  priceListId            String? @map("price_list_id") @db.Uuid

  orderDate        DateTime  @map("order_date") @db.Date
  expectedDate     DateTime? @map("expected_date") @db.Date
  /// The partner's own reference, quoted back on documents.
  customerPoNumber String?   @map("customer_po_number")
  customerPoDate   DateTime? @map("customer_po_date") @db.Date

  paymentTermsCode String? @map("payment_terms_code")

  billingAddressId  String? @map("billing_address_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  // ── Totals, frozen at approval (ADR-0011) ───────────────────────────────
  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  totalDiscount Decimal @default(0) @map("total_discount") @db.Decimal(18, 4)
  taxableValue  Decimal @default(0) @map("taxable_value") @db.Decimal(18, 4)
  totalCgst     Decimal @default(0) @map("total_cgst") @db.Decimal(18, 4)
  totalSgst     Decimal @default(0) @map("total_sgst") @db.Decimal(18, 4)
  totalIgst     Decimal @default(0) @map("total_igst") @db.Decimal(18, 4)
  totalTax      Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundOff      Decimal @default(0) @map("round_off") @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)

  /// True when the credit limit was breached and a Finance Manager overrode it.
  /// Kept on the order, not only in the audit log, so the exception is visible
  /// on the record itself rather than requiring an audit search.
  creditOverridden     Boolean @default(false) @map("credit_overridden")
  creditOverrideReason String? @map("credit_override_reason")

  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById String?   @map("approved_by_id") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  statusReason String?   @map("status_reason")

  notes String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines        OrderLine[]
  approvals    OrderApproval[]
  shipments    Shipment[]
  timeline     OrderTimeline[]
  reservations StockReservation[]
  invoices     Invoice[]

  @@index([status, orderDate(sort: Desc)])
  @@index([distributorId, status])
  @@index([customerId])
  @@index([quotationId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("order")
}

model OrderLine {
  id         String @id @default(uuid(7)) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  lineNumber Int    @map("line_number")

  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  sku             String
  description     String
  productRevision Int    @default(1) @map("product_revision")

  quantity Decimal @db.Decimal(18, 4)
  uomCode  String? @map("uom_code")

  /// ADR-0012: approval reserves what exists and backorders the rest, so a line
  /// tracks three quantities. `quantity` is what was ordered and never changes.
  quantityReserved      Decimal   @default(0) @map("quantity_reserved") @db.Decimal(18, 4)
  quantityBackordered   Decimal   @default(0) @map("quantity_backordered") @db.Decimal(18, 4)
  quantityDispatched    Decimal   @default(0) @map("quantity_dispatched") @db.Decimal(18, 4)
  /// From the product's lead time. An estimate, and labelled as one.
  expectedAvailableDate DateTime? @map("expected_available_date") @db.Date

  unitListPrice   Decimal @map("unit_list_price") @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)
  discountRuleId  String? @map("discount_rule_id") @db.Uuid
  overrideReason  String? @map("override_reason")

  taxableValue Decimal @map("taxable_value") @db.Decimal(18, 4)
  hsnSacCode   String? @map("hsn_sac_code")
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 4)
  sgst         Decimal @default(0) @db.Decimal(18, 4)
  igst         Decimal @default(0) @db.Decimal(18, 4)
  cess         Decimal @default(0) @db.Decimal(18, 4)
  totalTax     Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(18, 4)

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  shipmentLines ShipmentLine[]
  invoiceLines  InvoiceLine[]

  @@unique([orderId, lineNumber])
  @@index([productId])
  @@map("order_line")
}

/// Who approved what, against which ceiling. Append-only: an approval is a
/// statement someone made at a moment, and editing it would destroy the record
/// of who authorised a concession.
model OrderApproval {
  id      String       @id @default(uuid(7)) @db.Uuid
  orderId String       @map("order_id") @db.Uuid
  kind    ApprovalKind

  /// The figure approved and the ceiling the approver held, both recorded so
  /// the decision is explicable without re-deriving anyone's permissions.
  requestedValue  Decimal  @map("requested_value") @db.Decimal(18, 4)
  approverCeiling Decimal? @map("approver_ceiling") @db.Decimal(18, 4)

  approvedById String  @map("approved_by_id") @db.Uuid
  reason       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_approval")
}

/// A physical dispatch against an order.
model Shipment {
  id      String         @id @default(uuid(7)) @db.Uuid
  number  String         @unique
  orderId String         @map("order_id") @db.Uuid
  status  ShipmentStatus @default(PENDING)

  warehouseId String @map("warehouse_id") @db.Uuid

  // ── Carriage ────────────────────────────────────────────────────────────
  carrierName   String?  @map("carrier_name")
  /// Lorry Receipt number — the consignment note the transporter issues.
  lrNumber      String?  @map("lr_number")
  vehicleNumber String?  @map("vehicle_number")
  driverName    String?  @map("driver_name")
  driverPhone   String?  @map("driver_phone")
  freightAmount Decimal? @map("freight_amount") @db.Decimal(18, 4)

  packedAt     DateTime? @map("packed_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(3)

  /// Proof of delivery — the signed document, held as a Document row.
  podDocumentId String? @map("pod_document_id") @db.Uuid
  podReceivedBy String? @map("pod_received_by")

  notes String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  lines ShipmentLine[]

  @@index([orderId, status])
  @@index([status, dispatchedAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("shipment")
}

model ShipmentLine {
  id          String @id @default(uuid(7)) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid

  quantity Decimal  @db.Decimal(18, 4)
  /// Serials dispatched on this line, captured at dispatch (ADR-0009). Held as
  /// an array rather than a join because they are written once and read as a
  /// set — there is no per-serial state to track here.
  serials  String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderLineId])
  @@index([orderLineId])
  @@map("shipment_line")
}

// ═════════════════════════════════════════════════════════════════════════════
// FINANCE (Phase 8) — see docs/23-phase-8-design.md
//
// The phase with real legal exposure. Two rules shape everything below:
//
//   • An issued document is FROZEN, by database trigger, not by a service check
//     (ADR-0016). A service check protects the one path it sits on; this
//     codebase has twice shipped a control that silently did nothing.
//   • What a party owes is the SUM of an append-only ledger, never a stored
//     balance (ADR-0015). A balance column's failure mode is that it stays
//     plausible while diverging from the documents.
//
// None of these models carries `deletedAt`. Financial documents are cancelled,
// never deleted — which also keeps them out of the soft-delete extension by
// construction rather than by discipline.
// ═════════════════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Which GSTR-1 table this invoice lands in. Classified at issue and
/// snapshotted, because the rule reads the counterparty's GSTIN and the
/// invoice value AT THAT MOMENT — both of which can change afterwards.
enum SupplyType {
  /// Counterparty holds a GSTIN. GSTR-1 table 4.
  B2B
  /// Unregistered, inter-state, above the B2CL threshold. Table 5.
  B2CL
  /// Unregistered, everything else. Table 7, reported as a consolidated total.
  B2CS
  EXPORT
  SEZ
}

/// CGST s.34 recognises two correction documents with identical structure and
/// opposite sign. One table, separate number series — see ADR-0017.
enum TaxNoteType {
  CREDIT
  DEBIT
}

enum TaxNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// The statutory reason codes. Required on the document, and GSTR-1 9B carries
/// them, so this is data rather than free text.
enum TaxNoteReason {
  SALES_RETURN
  RATE_DIFFERENCE
  QUANTITY_DIFFERENCE
  POST_SALE_DISCOUNT
  DEFICIENCY_IN_SERVICE
  TAX_CORRECTION
  OTHER
}

enum PaymentMethod {
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  UPI
  DEMAND_DRAFT
  CARD
  /// A book adjustment rather than money moving — settling against a credit
  /// balance the party already holds.
  ADJUSTMENT
}

/// ADR-0018: RECORDED is a memo with no financial effect; VERIFIED is the
/// event. Allocation requires VERIFIED.
enum PaymentStatus {
  RECORDED
  VERIFIED
  BOUNCED
  CANCELLED
}

// `LedgerPartyType` is deliberately NOT a Prisma enum.
//
// It was one, alongside a `party_id` column, until scoping proved inexpressible
// against a column with no relation (see `LedgerEntry.distributorId`). The
// party is now two nullable foreign keys, and the DISTRIBUTOR | CUSTOMER
// vocabulary lives only in `@hixaa/contracts` where it is the API's shape. A
// Prisma enum nothing references is a column waiting to be reintroduced.

/// What caused a ledger row. DEBIT increases what the party owes Hixaa — the
/// convention is stated here, asserted in `ledger.spec.ts`, and nowhere else.
enum LedgerEntryType {
  OPENING_BALANCE
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  PAYMENT
  /// Tax deducted at source, credited separately from the cash it accompanies:
  /// TDS is recoverable from the government, cash is in the bank, and they
  /// reconcile against different statements (ADR-0018 §4).
  TDS
  WRITE_OFF
  ADJUSTMENT
}

/// A tax invoice. Immutable once issued (ADR-0016) — corrections go through a
/// TaxNote, which is the only lawful path under CGST s.34.
model Invoice {
  id     String        @id @default(uuid(7)) @db.Uuid
  /// Allocated from the gapless statutory series at ISSUE, never at draft.
  /// Null while DRAFT, which is what makes a draft free to delete.
  number String?       @unique
  status InvoiceStatus @default(DRAFT)

  distributorId String? @map("distributor_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid
  /// The order this bills, when there is one. A direct invoice has none and
  /// prices through PricingService.quote() instead.
  orderId       String? @map("order_id") @db.Uuid

  /// Both sides of the place-of-supply decision, snapshotted. The supplier's
  /// state is read from settings today; if the registration ever changes, a
  /// historical invoice must still say which rule produced its tax split.
  supplierStateCode      String @map("supplier_state_code")
  placeOfSupplyStateCode String @map("place_of_supply_state_code")

  supplyType      SupplyType @default(B2B) @map("supply_type")
  isReverseCharge Boolean    @default(false) @map("is_reverse_charge")

  /// The counterparty's statutory identity AS BILLED. Snapshotted because a
  /// GSTIN corrected next month must not rewrite a return already filed.
  counterpartyName  String  @map("counterparty_name")
  counterpartyGstin String? @map("counterparty_gstin")
  billingAddressId  String? @map("billing_address_id") @db.Uuid
  shippingAddressId String? @map("shipping_address_id") @db.Uuid

  invoiceDate      DateTime  @map("invoice_date") @db.Date
  /// Computed at issue from the order's payment terms and SNAPSHOTTED. Terms
  /// are editable; a due date printed on a document is not.
  dueDate          DateTime? @map("due_date") @db.Date
  paymentTermsCode String?   @map("payment_terms_code")

  customerPoNumber String?   @map("customer_po_number")
  customerPoDate   DateTime? @map("customer_po_date") @db.Date

  // ── Totals, frozen at issue by trigger ──────────────────────────────────
  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  totalDiscount Decimal @default(0) @map("total_discount") @db.Decimal(18, 4)
  taxableValue  Decimal @default(0) @map("taxable_value") @db.Decimal(18, 4)
  totalCgst     Decimal @default(0) @map("total_cgst") @db.Decimal(18, 4)
  totalSgst     Decimal @default(0) @map("total_sgst") @db.Decimal(18, 4)
  totalIgst     Decimal @default(0) @map("total_igst") @db.Decimal(18, 4)
  totalCess     Decimal @default(0) @map("total_cess") @db.Decimal(18, 4)
  totalTax      Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundOff      Decimal @default(0) @map("round_off") @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)

  // ── Settlement — the only money that moves after issue ───────────────────
  /// Cash plus TDS allocated here.
  amountPaid        Decimal @default(0) @map("amount_paid") @db.Decimal(18, 4)
  /// Credit notes less debit notes, so the outstanding identity holds for both
  /// without a branch (ADR-0017 §4).
  amountCredited    Decimal @default(0) @map("amount_credited") @db.Decimal(18, 4)
  /// grandTotal − amountPaid − amountCredited, maintained by a BEFORE trigger.
  ///
  /// A trigger rather than a GENERATED column: Prisma diffs GENERATED columns
  /// as drift and the next `migrate dev` proposes dropping them (HANDOFF
  /// §4.13). Stored rather than derived because the credit check and the aging
  /// report both filter on it.
  amountOutstanding Decimal @default(0) @map("amount_outstanding") @db.Decimal(18, 4)

  notes              String?
  termsAndConditions String? @map("terms_and_conditions")

  issuedAt        DateTime? @map("issued_at") @db.Timestamptz(3)
  issuedById      String?   @map("issued_by_id") @db.Uuid
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?   @map("cancelled_by_id") @db.Uuid
  cancelledReason String?   @map("cancelled_reason")

  // ── e-Invoice / e-Way Bill seam (ADR- none; docs/23 §9) ──────────────────
  // Columns exist so adopting a GSP later is a service binding rather than a
  // migration against a table holding legal documents. Nothing writes them yet.
  irn            String?   @unique
  ackNumber      String?   @map("ack_number")
  ackDate        DateTime? @map("ack_date") @db.Timestamptz(3)
  signedQrCode   String?   @map("signed_qr_code")
  ewayBillNumber String?   @map("eway_bill_number")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  taxNotes    TaxNote[]

  /// Aging and the overdue sweep read `(status, dueDate)` but only ever for
  /// invoices with something still owing, so migration 0010 adds a PARTIAL
  /// index on the same columns `WHERE amount_outstanding > 0`. Prisma cannot
  /// express a partial index — and skips what it cannot model, so it will not
  /// propose dropping that one (HANDOFF §4.13). This plain index stays for the
  /// settled-invoice lookups the partial one cannot serve.
  @@index([status, dueDate])
  @@index([distributorId, status])
  @@index([customerId, status])
  @@index([orderId])
  @@index([invoiceDate(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("invoice")
}

/// One invoiced line. Every value is COPIED from the order line's own snapshot
/// (ADR-0011), never referenced — a price list can be archived, a discount rule
/// deleted, a tax rate superseded, and this row still says what was billed.
model InvoiceLine {
  id         String @id @default(uuid(7)) @db.Uuid
  invoiceId  String @map("invoice_id") @db.Uuid
  lineNumber Int    @map("line_number")

  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  /// The order line this bills, so a partial invoice can be reconciled back to
  /// what was ordered and what has already been billed.
  orderLineId String? @map("order_line_id") @db.Uuid

  sku             String
  description     String
  productRevision Int    @default(1) @map("product_revision")

  quantity Decimal @db.Decimal(18, 4)
  uomCode  String? @map("uom_code")

  unitListPrice   Decimal @map("unit_list_price") @db.Decimal(18, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)

  taxableValue Decimal @map("taxable_value") @db.Decimal(18, 4)
  hsnSacCode   String? @map("hsn_sac_code")
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cessRate     Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 4)
  sgst         Decimal @default(0) @db.Decimal(18, 4)
  igst         Decimal @default(0) @db.Decimal(18, 4)
  cess         Decimal @default(0) @db.Decimal(18, 4)
  totalTax     Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(18, 4)

  /// Which TaxRate row authorised this line's rate, resolved against the
  /// INVOICE's date. Null means no rate table covered the HSN/SAC, which is a
  /// PRODUCT_SNAPSHOT fallback — fine for a quote, and refused at issue
  /// (docs/23 §5.1 refusal 3). Stored so the decision is on the record.
  taxRateId String? @map("tax_rate_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  orderLine    OrderLine?      @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  taxNoteLines TaxNoteLine[]

  @@unique([invoiceId, lineNumber])
  @@index([productId])
  @@index([orderLineId])
  @@map("invoice_line")
}

/// A credit or debit note under CGST s.34 — the only lawful way to correct an
/// issued invoice. One table for both types, separate number series (ADR-0017).
model TaxNote {
  id     String        @id @default(uuid(7)) @db.Uuid
  type   TaxNoteType
  number String?       @unique
  status TaxNoteStatus @default(DRAFT)

  /// The invoice being corrected. Required: a note that references nothing is
  /// not a correction, and GSTR-1 9B has nowhere to put it.
  originalInvoiceId String        @map("original_invoice_id") @db.Uuid
  reason            TaxNoteReason
  reasonNote        String?       @map("reason_note")

  /// Snapshotted from the invoice so the note stands alone as a document.
  supplierStateCode      String  @map("supplier_state_code")
  placeOfSupplyStateCode String  @map("place_of_supply_state_code")
  counterpartyName       String  @map("counterparty_name")
  counterpartyGstin      String? @map("counterparty_gstin")

  noteDate DateTime @map("note_date") @db.Date

  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(18, 4)
  totalCgst    Decimal @default(0) @map("total_cgst") @db.Decimal(18, 4)
  totalSgst    Decimal @default(0) @map("total_sgst") @db.Decimal(18, 4)
  totalIgst    Decimal @default(0) @map("total_igst") @db.Decimal(18, 4)
  totalCess    Decimal @default(0) @map("total_cess") @db.Decimal(18, 4)
  totalTax     Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  roundOff     Decimal @default(0) @map("round_off") @db.Decimal(18, 4)
  grandTotal   Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)

  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(3)
  issuedById  String?   @map("issued_by_id") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  originalInvoice Invoice       @relation(fields: [originalInvoiceId], references: [id], onDelete: Restrict)
  lines           TaxNoteLine[]

  @@index([originalInvoiceId])
  @@index([type, status, noteDate(sort: Desc)])
  @@index([noteDate(sort: Desc), id(sort: Desc)])
  @@map("tax_note")
}

model TaxNoteLine {
  id         String @id @default(uuid(7)) @db.Uuid
  taxNoteId  String @map("tax_note_id") @db.Uuid
  lineNumber Int    @map("line_number")

  /// The invoice line being corrected, when the note is line-specific. Null for
  /// a document-level correction such as a post-sale discount.
  invoiceLineId String? @map("invoice_line_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid

  sku         String?
  description String

  quantity  Decimal? @db.Decimal(18, 4)
  uomCode   String?  @map("uom_code")
  unitPrice Decimal? @map("unit_price") @db.Decimal(18, 4)

  taxableValue Decimal @map("taxable_value") @db.Decimal(18, 4)
  hsnSacCode   String? @map("hsn_sac_code")
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cessRate     Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 4)
  sgst         Decimal @default(0) @db.Decimal(18, 4)
  igst         Decimal @default(0) @db.Decimal(18, 4)
  cess         Decimal @default(0) @db.Decimal(18, 4)
  totalTax     Decimal @default(0) @map("total_tax") @db.Decimal(18, 4)
  lineTotal    Decimal @map("line_total") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxNote     TaxNote      @relation(fields: [taxNoteId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([taxNoteId, lineNumber])
  @@index([invoiceLineId])
  @@map("tax_note_line")
}

/// A receipt. Recording it is a memo; VERIFYING it is the financial event that
/// touches the ledger, and only a verified payment can be allocated (ADR-0018).
model Payment {
  id     String        @id @default(uuid(7)) @db.Uuid
  number String        @unique
  status PaymentStatus @default(RECORDED)

  distributorId String? @map("distributor_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  method PaymentMethod

  /// Cash actually received. TDS is held separately because the two reconcile
  /// against different statements — the bank, and Form 26AS.
  amount            Decimal @db.Decimal(18, 4)
  tdsAmount         Decimal @default(0) @map("tds_amount") @db.Decimal(18, 4)
  /// amount + tdsAmount, less what is already allocated. Maintained alongside
  /// allocations under the same row lock that prevents over-allocation.
  unallocatedAmount Decimal @default(0) @map("unallocated_amount") @db.Decimal(18, 4)

  paymentDate DateTime @map("payment_date") @db.Date

  // ── Instrument ──────────────────────────────────────────────────────────
  referenceNumber String?   @map("reference_number")
  bankName        String?   @map("bank_name")
  chequeNumber    String?   @map("cheque_number")
  chequeDate      DateTime? @map("cheque_date") @db.Date

  notes String?

  recordedById String    @map("recorded_by_id") @db.Uuid
  /// Must differ from `recordedById`. Enforced in the service as well as by the
  /// role-level segregation rule, because one PERSON can hold two roles.
  verifiedById String?   @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)

  bouncedAt     DateTime? @map("bounced_at") @db.Timestamptz(3)
  bouncedReason String?   @map("bounced_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  @@index([status, paymentDate(sort: Desc)])
  @@index([distributorId, status])
  @@index([customerId, status])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("payment")
}

/// Which receipt settled which invoice, and by how much. One payment may settle
/// several invoices and one invoice may take several payments, so this is a
/// table rather than a column on either side.
model PaymentAllocation {
  id        String @id @default(uuid(7)) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  amount     Decimal @db.Decimal(18, 4)
  /// The part of `amount` that is TDS rather than cash, so an invoice can
  /// report how it was settled without joining back through the payment.
  tdsPortion Decimal @default(0) @map("tds_portion") @db.Decimal(18, 4)

  notes String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

/// The party ledger — append-only, and the source of truth for what is owed
/// (ADR-0015).
///
/// UPDATE and DELETE are rejected by trigger, exactly as `stock_ledger_entry`
/// is. A mistake is corrected by a CONTRA entry, so the wrong row stays visible.
model LedgerEntry {
  id String @id @default(uuid(7)) @db.Uuid

  /// The party, as two nullable FKs with a CHECK that exactly one is set —
  /// the same shape `invoice` and `payment` use.
  ///
  /// This began as `partyType` + `partyId`, which reads well and cannot be
  /// SCOPED: `partyId` deliberately points at one of two tables, so it has no
  /// relation for the scope extension to nest through, and Prisma has no
  /// correlated subquery to fall back on. Rather than resolve the caller's
  /// visible distributor and customer ids on every request, the columns became
  /// real foreign keys and `viaDistributorOrCustomer()` — already written for
  /// orders — applies unchanged.
  ///
  /// `partyType` is still the API's vocabulary; the service derives it.
  distributorId String? @map("distributor_id") @db.Uuid
  customerId    String? @map("customer_id") @db.Uuid

  entryType LedgerEntryType @map("entry_type")

  /// Exactly one of these is non-zero — `CHECK ((debit = 0) <> (credit = 0))`.
  /// DEBIT increases what the party owes Hixaa.
  debit  Decimal @default(0) @db.Decimal(18, 4)
  credit Decimal @default(0) @db.Decimal(18, 4)

  /// What caused this row: `Invoice`, `Payment`, `TaxNote`, or null for a
  /// manual adjustment.
  refType   String? @map("ref_type")
  refId     String? @map("ref_id") @db.Uuid
  /// The document number as printed, so a statement is readable without joins.
  refNumber String? @map("ref_number")

  /// The entry this one reverses, for a contra posting.
  reversesId String? @map("reverses_id") @db.Uuid

  entryDate DateTime @map("entry_date") @db.Date
  narration String

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Statement of account, in order, with a stable tiebreak. `id` is a UUID v7
  /// so it sorts by insertion time — two entries on the same date still have a
  /// deterministic order, which a running balance depends on.
  @@index([distributorId, entryDate, id])
  @@index([customerId, entryDate, id])
  @@index([refType, refId])
  @@index([entryType])
  @@map("ledger_entry")
}

/// Append-only event feed per order — the "what happened to this order" screen.
///
/// Distinct from `audit_log`, which is system-wide, security-oriented, and
/// keyed by entity. This is a business narrative a salesperson reads.
model OrderTimeline {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  event       String
  description String
  metadata    Json?

  actorId String? @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_timeline")
}

// ═════════════════════════════════════════════════════════════════════════════
// INTELLIGENCE (Phase 9) — see docs/25-phase-9-design.md
//
// This phase mostly READS, which is why so little is added here. The one rule:
// nothing in Phase 9 may change a business fact. `Notification` records
// something the system said; `ReportDefinition` and `ReportRun` record what
// someone asked for. Neither is a business fact — a reporting layer that can
// write is how "fix the number in the report" eventually becomes an UPDATE
// against a ledger.
//
// There are deliberately NO materialised views. They were specified in Phase 0,
// measured in Phase 9, and dropped — ADR-0019 carries the numbers.
// ═════════════════════════════════════════════════════════════════════════════

/// The report CATALOGUE, as an enum rather than a query builder (ADR-0020).
///
/// A user saves a configured instance of one of these; they never supply a
/// query shape. Adding a report is a catalogue entry and a function, which is
/// a deploy — and for a six-report domain that is a better trade than owning a
/// DSL that has to inject scope predicates correctly into queries nobody
/// anticipated.
enum ReportType {
  SALES_SUMMARY
  DISTRIBUTOR_PERFORMANCE
  PRODUCT_PERFORMANCE
  /// EXCLUDES `DISTRIBUTOR` warehouses — those goods are sold (ADR-0014 §4).
  STOCK_VALUATION
  RECEIVABLES_AGING
  /// Delegates to GstReturnsService rather than recomputing: a report and a
  /// filing that disagree is worse than either alone.
  GST_SUMMARY
}

enum ReportFormat {
  CSV
  XLSX
  PDF
}

enum ReportRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum TargetPeriodType {
  MONTH
  QUARTER
  YEAR
}

/// A saved, named instance of a catalogue report plus its validated parameters.
model ReportDefinition {
  id   String     @id @default(uuid(7)) @db.Uuid
  type ReportType
  name String

  description String?

  /// Validated against the catalogue entry's Zod schema at SAVE time and again
  /// at RUN time. A definition saved against a parameter that has since changed
  /// shape fails loudly on the next run rather than producing a quietly wrong
  /// report.
  parameters Json @default("{}")

  format ReportFormat @default(CSV)

  /// Visible to everyone who may read reports, rather than only its author.
  isShared Boolean @default(false) @map("is_shared")

  // ── Scheduling (module 9.5) ─────────────────────────────────────────────
  /// Null when the report is run on demand only.
  cronExpression   String?   @map("cron_expression")
  /// Where a scheduled run is emailed. Business channel — these reach partners.
  recipients       String[]
  isScheduleActive Boolean   @default(false) @map("is_schedule_active")
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(3)
  nextRunAt        DateTime? @map("next_run_at") @db.Timestamptz(3)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      ReportRun[]

  @@index([type])
  @@index([createdById])
  @@index([isScheduleActive, nextRunAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([deletedAt])
  @@map("report_definition")
}

/// One execution of a report. Append-only in practice: a run says what was
/// produced at a moment, and editing it would destroy the record of what a
/// recipient actually received.
model ReportRun {
  id           String          @id @default(uuid(7)) @db.Uuid
  definitionId String?         @map("definition_id") @db.Uuid
  /// Denormalised so an ad-hoc run (no saved definition) still says what it was.
  type         ReportType
  status       ReportRunStatus @default(QUEUED)
  format       ReportFormat

  /// The parameters ACTUALLY used, snapshotted — a saved definition can be
  /// edited afterwards, and a run must still explain its own numbers.
  parameters Json @default("{}")

  rowCount   Int?    @map("row_count")
  /// Null for a synchronous run under the row cap, which streams straight back
  /// rather than producing a stored file.
  documentId String? @map("document_id") @db.Uuid

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  durationMs  Int?      @map("duration_ms")
  error       String?

  /// True when a scheduler produced this rather than a person.
  isScheduled Boolean @default(false) @map("is_scheduled")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id") @db.Uuid

  definition ReportDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  document   Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([definitionId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("report_run")
}

/// A sales target, so "target vs achievement" has something to compare against.
///
/// Exactly ONE dimension is set — territory, distributor, or product — enforced
/// by a CHECK. A target against two dimensions at once is ambiguous about what
/// it measures, and the ambiguity only surfaces when the achievement figure
/// looks wrong.
model SalesTarget {
  id String @id @default(uuid(7)) @db.Uuid

  periodType  TargetPeriodType @map("period_type")
  /// First day of the period. Stored as a date so a target is unambiguous about
  /// which month it belongs to regardless of the reader's timezone.
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date

  territoryId   String? @map("territory_id") @db.Uuid
  distributorId String? @map("distributor_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid

  /// Revenue target, GST-exclusive so it compares against taxable value rather
  /// than against a figure that moves when a rate changes.
  targetAmount   Decimal  @map("target_amount") @db.Decimal(18, 4)
  /// Optional unit target, for product lines measured in volume.
  targetQuantity Decimal? @map("target_quantity") @db.Decimal(18, 4)

  notes String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid

  territory   Territory?   @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([periodStart, periodEnd])
  @@index([territoryId, periodStart])
  @@index([distributorId, periodStart])
  @@index([productId, periodStart])
  @@index([deletedAt])
  @@map("sales_target")
}
