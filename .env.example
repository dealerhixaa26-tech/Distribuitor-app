# ─────────────────────────────────────────────────────────────────────────────
# Hixaa DMS — environment template
#
# Copy to `.env` and fill in. Every variable is validated by a Zod schema at
# boot (apps/api/src/config/env.schema.ts); a missing or malformed value crashes
# the process immediately with a readable message rather than surfacing as
# `undefined` inside a request three days later.
#
# 🔐 = secret. NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Hixaa DMS"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
API_PREFIX=api/v1
TZ=Asia/Kolkata
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# 🔐
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hixaa_dms?schema=public
DATABASE_POOL_SIZE=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_SLOW_QUERY_MS=200

# ── Redis & queues ───────────────────────────────────────────────────────────
# 🔐
REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=hixaa
QUEUE_CONCURRENCY=5
WORKER_ENABLED=true
# Waiting jobs above which a queue raises an ops alert. Checked on all five
# queues every 10 minutes, not just email.
QUEUE_DEPTH_ALERT_THRESHOLD=500
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# ── Authentication ───────────────────────────────────────────────────────────
# 🔐 Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_dev_only_secret_at_least_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d
JWT_ISSUER=hixaa-dms
SESSION_COOKIE_NAME=hixaa_rt
SESSION_COOKIE_DOMAIN=localhost
# 🔐 openssl rand -base64 32
CSRF_SECRET=CHANGE_ME_dev_only_csrf_secret_32_chars
# 🔐 openssl rand -base64 32  — AES-256-GCM for bank details & MFA secrets
ENCRYPTION_KEY_V1=CHANGE_ME_base64_32_byte_key_for_aes_256_gcm
ENCRYPTION_KEY_ACTIVE=V1
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MFA_ISSUER="Hixaa DMS"

# ── ✉️  BUSINESS email — Hostinger (customer-facing ONLY) ────────────────────
# Welcome, verify email, password reset, order/dispatch/invoice/payment
# notifications, distributor comms, scheduled reports, reminders.
MAIL_BUSINESS_DRIVER=smtp
MAIL_BUSINESS_HOST=smtp.hostinger.com
MAIL_BUSINESS_PORT=465
MAIL_BUSINESS_SECURE=true
# 🔐
MAIL_BUSINESS_USER=noreply@hixaa.com
# 🔐
MAIL_BUSINESS_PASSWORD=
MAIL_BUSINESS_FROM_NAME="Hixaa Technologies"
MAIL_BUSINESS_FROM_ADDRESS=noreply@hixaa.com
MAIL_BUSINESS_REPLY_TO=info@hixaa.com

# ── 🛠  OPS email — Gmail (developer/infrastructure ONLY) ────────────────────
# Deploys, migrations, backups, error alerts, health failures, security events.
# NEVER used for customer-facing mail — enforced at the type level.
MAIL_OPS_DRIVER=smtp
MAIL_OPS_HOST=smtp.gmail.com
MAIL_OPS_PORT=587
MAIL_OPS_SECURE=false
# 🔐
MAIL_OPS_USER=
# 🔐 Google App Password — NOT the account password
MAIL_OPS_PASSWORD=
MAIL_OPS_FROM_ADDRESS=
# ⚠️ REQUIRED IN PRODUCTION — the API refuses to boot without it (ADR-0022).
# Every ops alert routes here: queue backlogs, dead letters, failed backups,
# health-check failures, stock reconciliation drift, and security events such as
# refresh-token reuse. With this empty, each one is recorded in email_log as
# UNDELIVERABLE and read by nobody.
MAIL_OPS_TO=

# ── Database backups (10.3, ADR-0024) ────────────────────────────────────────
# REQUIRED IN PRODUCTION — the API refuses to boot without both of the first
# two. An unencrypted backup is a copy of every customer, price and bank detail
# in a file with no lock on it.
BACKUP_ENABLED=false
# GPG public key id or email. Generate the keypair on YOUR machine and import
# only the PUBLIC key here — the server must be able to create backups and NOT
# read them. Keep the private key in a password manager plus one offline copy;
# it is the recovery plan. See docs/29-backup-and-restore.md.
BACKUP_GPG_RECIPIENT=
# A MOUNTED path, not the database's own disk — a backup on the same disk
# protects against neither disk failure nor the machine going away.
BACKUP_DIR=./storage/backups
# 01:30 IST: before the 02:00 Sheets sync (no contention) and before the 03:00
# retention purge, so a backup captures the rows that purge is about to delete.
BACKUP_CRON=30 1 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# DROPPED and recreated on every rehearsal — never name a real database.
BACKUP_REHEARSAL_DB=hixaa_dms_rehearsal
# Monthly. A backup nobody has restored is not a backup (ADR-0024).
BACKUP_REHEARSAL_CRON=0 4 1 * *

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_SIGNED_URL_TTL=900
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_SIZE_DRAWING_MB=50
VIRUS_SCAN_DRIVER=noop
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=hixaa-dms
# S3_ACCESS_KEY_ID=          🔐
# S3_SECRET_ACCESS_KEY=      🔐

# ── Google Sheets backup ─────────────────────────────────────────────────────
SHEETS_ENABLED=false
# 🔐
SHEETS_SERVICE_ACCOUNT_EMAIL=
# 🔐
SHEETS_PRIVATE_KEY=
SHEETS_SPREADSHEET_ID_PRIMARY=
SHEETS_SPREADSHEET_ID_TRANSACTIONS=
SHEETS_SYNC_CRON="0 2 * * *"
SHEETS_BATCH_SIZE=1000
SHEETS_MAX_REQUESTS_PER_MINUTE=250

# ── Search, cache, throttling ────────────────────────────────────────────────
SEARCH_DRIVER=postgres
CACHE_TTL_DEFAULT=300
CACHE_TTL_DASHBOARD=300
CACHE_TTL_REFERENCE=3600
THROTTLE_TTL=60
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=5
CORS_ORIGINS=http://localhost:3000

# ── Business configuration (bootstrap only) ──────────────────────────────────
# Seeded into SYSTEM_SETTING on first boot; the DB is authoritative thereafter
# and these become editable from the Admin Panel.
COMPANY_LEGAL_NAME="Hixaa Technologies Pvt. Ltd."
COMPANY_TRADE_NAME="HIXAA"
# Placeholder is checksum-valid so dev boots; REPLACE with Hixaa's real GSTIN
# before issuing any invoice (open question E1 in docs/12-recommendations.md).
COMPANY_GSTIN=27AAAAA0000A1Z2
COMPANY_PAN=AAAAA0000A
COMPANY_STATE_CODE=27
COMPANY_ADDRESS="Yogeshwar, Plot #26B, Anmol Nagar, Behind Santaji Nursing Home, Wathoda Square, Nagpur, Maharashtra 440035"
COMPANY_EMAIL=info@hixaa.com
COMPANY_PHONE=+91-9372429144
DEFAULT_CURRENCY=INR
FINANCIAL_YEAR_START_MONTH=4
INVOICE_NUMBER_PREFIX=HTPL/INV
ORDER_NUMBER_PREFIX=SO

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_MFA_ENABLED=false
FEATURE_SECONDARY_SALES=true
FEATURE_EINVOICE=false
FEATURE_SHEETS_BACKUP=false
FEATURE_SWAGGER=true

# ── Bootstrap (first run only) ───────────────────────────────────────────────
# 🔐 Super admin created once; forced to change password on first login.
#
# ⚠ ALWAYS QUOTE values containing # — dotenv treats an unquoted # as the start
#   of a comment, so `pass#2026` silently becomes `pass`. Quote any secret with
#   #, spaces, or a trailing $ to be safe.
SEED_SUPER_ADMIN_EMAIL=admin@hixaa.com
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!Now#2026"
