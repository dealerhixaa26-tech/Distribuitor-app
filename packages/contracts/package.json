{
  "name": "@hixaa/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for every DTO shape, enum, and permission key. Consumed by the NestJS validation pipe, OpenAPI generation, React Hook Form, and both apps' TypeScript. See ADR-0001.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hixaa/config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
